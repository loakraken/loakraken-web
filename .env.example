# Server-only LOAKraken backend origin. Never put a Lost Ark API key here.
LOAKRAKEN_API_ORIGIN=http://127.0.0.1:8080
# Search engine ownership codes (production only; no tag when empty). Set on the server, never here.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
# User's own API key (BYOK): off by default; the api has its own BYOK_ENABLED.
# On only with a seal secret: in production a file secret (path below, base64 of
# 32 random bytes, never in env); BYOK_SEAL_KEY (base64) is read outside production only.
BYOK_ENABLED=false
BYOK_SEAL_KEY_FILE=
