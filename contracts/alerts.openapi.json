{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken alerts",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/alerts/vapid-public-key": {
      "get": {
        "tags": [
          "시세 알림"
        ],
        "summary": "웹 푸시 공개 키",
        "description": "브라우저 PushManager.subscribe의 applicationServerKey(base64url).",
        "operationId": "vapidPublicKey",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVapidKeyResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/items": {
      "get": {
        "tags": [
          "시세 알림"
        ],
        "summary": "알림을 걸 수 있는 품목",
        "description": "최근 시세를 관측한 품목과 현재 판매 최저가입니다.",
        "operationId": "items_1",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListAlertItemResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/subscriptions": {
      "post": {
        "tags": [
          "시세 알림"
        ],
        "summary": "알림 구독 만들기",
        "description": "브라우저 PushSubscription(endpoint·keys)을 등록하고 관리 토큰을 한 번 돌려줍니다(다시 보여 주지 않음). 같은 endpoint로 다시 등록하면 키와 토큰을 바꾸고(옛 토큰 무효) 옛 조건을 지웁니다. 등록 전에 확인 알림(본문 {\"type\":\"SUBSCRIBED\"}, 가격 알림은 type PRICE)을 보내고, 푸시 서비스가 받지 않으면 저장하지 않습니다(400 ALERT_PUSH_NOT_DELIVERED, 푸시 서비스 일시 장애면 503 ALERT_PUSH_UNAVAILABLE, 전체 구독 상한이면 503 ALERTS_FULL). 조건 없이 24시간 동안 쓰지 않은 구독은 지웁니다. 400 INVALID_REQUEST·ALERT_INVALID_SUBSCRIPTION·ALERT_PUSH_NOT_DELIVERED·ALERT_ITEM_NOT_ALERTABLE·ALERT_TOO_MANY_CONDITIONS, 404 ALERT_SUBSCRIPTION_NOT_FOUND·ALERT_CONDITION_NOT_FOUND, 429 CLIENT_RATE_LIMITED, 503 ALERTS_FULL·ALERT_PUSH_UNAVAILABLE",
        "operationId": "subscribe",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscribeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSubscriptionResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/subscriptions/{subscriptionId}": {
      "delete": {
        "tags": [
          "시세 알림"
        ],
        "summary": "알림 구독 끄기",
        "description": "구독과 조건을 즉시 지웁니다. 400 INVALID_REQUEST·ALERT_INVALID_SUBSCRIPTION·ALERT_PUSH_NOT_DELIVERED·ALERT_ITEM_NOT_ALERTABLE·ALERT_TOO_MANY_CONDITIONS, 404 ALERT_SUBSCRIPTION_NOT_FOUND·ALERT_CONDITION_NOT_FOUND, 429 CLIENT_RATE_LIMITED, 503 ALERTS_FULL·ALERT_PUSH_UNAVAILABLE",
        "operationId": "unsubscribe",
        "parameters": [
          {
            "name": "subscriptionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Alert-Token",
            "in": "header",
            "description": "관리 토큰",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "minLength": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/subscriptions/{subscriptionId}/conditions": {
      "get": {
        "tags": [
          "시세 알림"
        ],
        "summary": "알림 조건 목록",
        "description": "400 INVALID_REQUEST·ALERT_INVALID_SUBSCRIPTION·ALERT_PUSH_NOT_DELIVERED·ALERT_ITEM_NOT_ALERTABLE·ALERT_TOO_MANY_CONDITIONS, 404 ALERT_SUBSCRIPTION_NOT_FOUND·ALERT_CONDITION_NOT_FOUND, 429 CLIENT_RATE_LIMITED, 503 ALERTS_FULL·ALERT_PUSH_UNAVAILABLE",
        "operationId": "conditions",
        "parameters": [
          {
            "name": "subscriptionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Alert-Token",
            "in": "header",
            "description": "관리 토큰",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "minLength": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListConditionResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "시세 알림"
        ],
        "summary": "알림 조건 추가",
        "description": "그 품목의 판매 최저가가 기준 가격 이하(AT_OR_BELOW) 또는 이상(AT_OR_ABOVE)이 될 때 보냅니다. 만들 때 이미 조건에 맞으면(matchedNow=true) 보내지 않고, 조건에서 벗어났다가 다시 맞을 때 보냅니다. 400 INVALID_REQUEST·ALERT_INVALID_SUBSCRIPTION·ALERT_PUSH_NOT_DELIVERED·ALERT_ITEM_NOT_ALERTABLE·ALERT_TOO_MANY_CONDITIONS, 404 ALERT_SUBSCRIPTION_NOT_FOUND·ALERT_CONDITION_NOT_FOUND, 429 CLIENT_RATE_LIMITED, 503 ALERTS_FULL·ALERT_PUSH_UNAVAILABLE",
        "operationId": "addCondition",
        "parameters": [
          {
            "name": "subscriptionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Alert-Token",
            "in": "header",
            "description": "관리 토큰",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "minLength": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConditionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseConditionResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/subscriptions/{subscriptionId}/conditions/{conditionId}": {
      "delete": {
        "tags": [
          "시세 알림"
        ],
        "summary": "알림 조건 지우기",
        "description": "400 INVALID_REQUEST·ALERT_INVALID_SUBSCRIPTION·ALERT_PUSH_NOT_DELIVERED·ALERT_ITEM_NOT_ALERTABLE·ALERT_TOO_MANY_CONDITIONS, 404 ALERT_SUBSCRIPTION_NOT_FOUND·ALERT_CONDITION_NOT_FOUND, 429 CLIENT_RATE_LIMITED, 503 ALERTS_FULL·ALERT_PUSH_UNAVAILABLE",
        "operationId": "deleteCondition",
        "parameters": [
          {
            "name": "subscriptionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "conditionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Alert-Token",
            "in": "header",
            "description": "관리 토큰",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "minLength": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseVapidKeyResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/VapidKeyResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "VapidKeyResponse": {
        "type": "object",
        "properties": {
          "publicKey": {
            "type": "string",
            "description": "base64url 비압축 P-256 공개 키"
          }
        },
        "required": [
          "publicKey"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "ApiResponseListAlertItemResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "type": "array",
            "description": "성공 응답 데이터. 오류일 때 null",
            "items": {
              "$ref": "#/components/schemas/AlertItemResponse"
            }
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "AlertItemResponse": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "integer",
            "format": "int64"
          },
          "itemName": {
            "type": "string"
          },
          "currentMinPrice": {
            "anyOf": [
              {
                "type": "number",
                "description": "현재 판매 최저가(매물이 없으면 null)"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "currentMinPrice",
          "itemId",
          "itemName",
          "observedAt"
        ]
      },
      "SubscribeRequest": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "description": "PushSubscription.endpoint(브라우저 푸시 서비스 https 주소)",
            "maxLength": 1024,
            "minLength": 0
          },
          "keys": {
            "$ref": "#/components/schemas/SubscribeKeys"
          }
        },
        "required": [
          "endpoint",
          "keys"
        ]
      },
      "SubscribeKeys": {
        "type": "object",
        "properties": {
          "p256dh": {
            "type": "string",
            "description": "base64url",
            "maxLength": 128,
            "minLength": 0
          },
          "auth": {
            "type": "string",
            "description": "base64url",
            "maxLength": 64,
            "minLength": 0
          }
        },
        "required": [
          "auth",
          "p256dh"
        ]
      },
      "ApiResponseSubscriptionResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/SubscriptionResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "SubscriptionResponse": {
        "type": "object",
        "properties": {
          "subscriptionId": {
            "type": "string",
            "format": "uuid"
          },
          "manageToken": {
            "type": "string",
            "description": "관리 토큰. 이 응답에서만 보이고 다시 보여 주지 않습니다. 이후 요청의 X-Alert-Token 헤더"
          }
        },
        "required": [
          "manageToken",
          "subscriptionId"
        ]
      },
      "ApiResponseVoid": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "ApiResponseListConditionResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "type": "array",
            "description": "성공 응답 데이터. 오류일 때 null",
            "items": {
              "$ref": "#/components/schemas/ConditionResponse"
            }
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "ConditionResponse": {
        "type": "object",
        "properties": {
          "conditionId": {
            "type": "string",
            "format": "uuid"
          },
          "itemId": {
            "type": "integer",
            "format": "int64"
          },
          "itemName": {
            "type": "string"
          },
          "comparator": {
            "type": "string",
            "description": "AT_OR_BELOW(이하) 또는 AT_OR_ABOVE(이상)"
          },
          "price": {
            "type": "number"
          },
          "matchedNow": {
            "type": "boolean",
            "description": "지금 조건에 맞는가(만들 때 맞으면 보내지 않고 시작)"
          },
          "currentMinPrice": {
            "anyOf": [
              {
                "type": "number",
                "description": "그 품목의 현재 판매 최저가(매물이 없으면 null)"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSentAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "마지막으로 보낸 시각(없으면 null)"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "comparator",
          "conditionId",
          "createdAt",
          "currentMinPrice",
          "itemId",
          "itemName",
          "lastSentAt",
          "matchedNow",
          "observedAt",
          "price"
        ]
      },
      "ConditionRequest": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "integer",
            "format": "int64",
            "exclusiveMinimum": 0
          },
          "comparator": {
            "type": "string",
            "enum": [
              "AT_OR_BELOW",
              "AT_OR_ABOVE"
            ]
          },
          "price": {
            "type": "number",
            "maximum": 999999999999.99,
            "minimum": 0.01
          }
        },
        "required": [
          "comparator",
          "price"
        ]
      },
      "ApiResponseConditionResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
