{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken card-collection",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/card-collection": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "원정대 카드 기록",
        "description": "원정대 캐릭터가 LOAKraken에서 검색되거나 통계 수집기에 수집될 때 장착한 카드를 기록해, 카드별 최고 각성과 속성 6칸(성·암·뇌·토·수·화) 세트 기록, 보유 카드로 구성할 수 있는 세트를 줍니다. 공식 API에 카드 도감이 없어 실제 보유의 하한입니다. 원정대 목록은 /siblings 캐시를 공유합니다(공식 호출 최대 1회). 기록이 없어도 200입니다.",
        "operationId": "cardCollection",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "원정대를 조회할 캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "원정대를 조회할 캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCardCollectionResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: 캐릭터명 누락 또는 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "LOST_ARK_RATE_LIMITED / CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "LOST_ARK_API_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CARD_COLLECTION_DISABLED, CARD_COLLECTION_UNAVAILABLE, LOST_ARK_NOT_CONFIGURED 또는 CHARACTER_CACHE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "LOST_ARK_API_TIMEOUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/characters/card-collection/refresh": {
      "post": {
        "tags": [
          "캐릭터"
        ],
        "summary": "원정대 카드 기록 채우기",
        "description": "같은 서버 원정대 중 최근 7일 안에 프로필을 관측하지 못한 캐릭터를 아이템 레벨이 높은 순으로 최대 12명 조회해 카드 기록을 채웁니다. 캐릭터 검색과 같은 경로라 공식 호출은 1회 최대 12회이고, 원정대 목록은 캐시를 씁니다. 같은 원정대는 10분에 1회만 받으며, 쿨다운 중에는 429와 Retry-After(초)를 줍니다. 카드 기록은 비동기로 저장되므로 응답 직후 card-collection을 다시 조회하면 됩니다.",
        "operationId": "refreshCardCollection",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "원정대를 조회할 캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "원정대를 조회할 캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          }
        ],
        "responses": {
          "200": {
            "description": "처리 완료(일부 실패 포함)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCardCollectionRefreshResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: 캐릭터명 누락 또는 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CARD_COLLECTION_REFRESH_COOLDOWN(Retry-After 헤더) 또는 LOST_ARK_RATE_LIMITED / CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "LOST_ARK_API_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CARD_COLLECTION_DISABLED, CARD_COLLECTION_UNAVAILABLE, LOST_ARK_NOT_CONFIGURED 또는 CHARACTER_CACHE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "LOST_ARK_API_TIMEOUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseCardCollectionResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CardCollectionResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CardCollectionResponse": {
        "type": "object",
        "description": "원정대 카드 기록(card-record-v1). 원정대 캐릭터가 검색되거나 수집될 때 장착한 카드를 기록한 값이라 실제 보유의 하한입니다. 기록이 없어도 200이며 record는 null, cards·sets는 빈 배열입니다.",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "serverName": {
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "string",
                "description": "아직 판정 전이면 null",
                "enum": [
                  "DEALER",
                  "SUPPORT"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "rosterCharacters": {
            "type": "integer",
            "format": "int32",
            "description": "같은 서버 원정대 캐릭터 수"
          },
          "observedCharacters": {
            "type": "integer",
            "format": "int32",
            "description": "그중 카드 기록이 있는 캐릭터 수"
          },
          "ruleVersion": {
            "type": "string"
          },
          "elementRecords": {
            "$ref": "#/components/schemas/CardCollectionElementRecordsResponse"
          },
          "cards": {
            "type": "array",
            "description": "카드별 최고 각성(이름순)",
            "items": {
              "$ref": "#/components/schemas/CardCollectionCardResponse"
            }
          },
          "sets": {
            "type": "array",
            "description": "보유 카드로 구성할 수 있는 2세트 이상 세트(각성 합 내림차순). 장착한 적이 없어도 계산합니다.",
            "items": {
              "$ref": "#/components/schemas/CardCollectionSetResponse"
            }
          }
        },
        "required": [
          "cards",
          "characterName",
          "elementRecords",
          "observedCharacters",
          "position",
          "rosterCharacters",
          "ruleVersion",
          "serverName",
          "sets"
        ]
      },
      "CardCollectionElementRecordsResponse": {
        "type": "object",
        "description": "속성 6칸. 순서는 성·암·뇌·토·수·화(LIGHT, DARK, LIGHTNING, EARTH, WATER, FIRE)",
        "properties": {
          "dealer": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardCollectionElementSlotResponse"
            }
          },
          "supporter": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardCollectionElementSlotResponse"
            }
          }
        },
        "required": [
          "dealer",
          "supporter"
        ]
      },
      "CardCollectionElementSlotResponse": {
        "type": "object",
        "properties": {
          "element": {
            "type": "string",
            "enum": [
              "LIGHT",
              "DARK",
              "LIGHTNING",
              "EARTH",
              "WATER",
              "FIRE"
            ]
          },
          "setName": {
            "type": "string",
            "description": "공식 세트명",
            "example": "세상을 구하는 빛"
          },
          "record": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CardCollectionSetRecordResponse",
                "description": "2세트 이상 구성할 수 있을 때만"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "element",
          "record",
          "setName"
        ]
      },
      "CardCollectionSetRecordResponse": {
        "type": "object",
        "properties": {
          "cardCount": {
            "type": "integer",
            "format": "int32"
          },
          "awakening": {
            "type": "integer",
            "format": "int32",
            "description": "사용한 카드의 실제 각성 합"
          },
          "activeAwakening": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "달성한 각성합계 단계(예: 30). 학습한 효과 기준"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordedBy": {
            "type": "string",
            "description": "가장 최근 기록을 남긴 원정대 캐릭터"
          }
        },
        "required": [
          "activeAwakening",
          "awakening",
          "cardCount",
          "observedAt",
          "recordedBy"
        ]
      },
      "CardCollectionCardResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "grade": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "awakeCount": {
            "type": "integer",
            "format": "int32"
          },
          "awakeTotal": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordedBy": {
            "type": "string"
          }
        },
        "required": [
          "awakeCount",
          "awakeTotal",
          "grade",
          "icon",
          "name",
          "observedAt",
          "recordedBy"
        ]
      },
      "CardCollectionSetResponse": {
        "type": "object",
        "properties": {
          "setName": {
            "type": "string"
          },
          "cardCount": {
            "type": "integer",
            "format": "int32"
          },
          "awakening": {
            "type": "integer",
            "format": "int32"
          },
          "activeAwakening": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32"
              },
              {
                "type": "null"
              }
            ]
          },
          "cards": {
            "type": "array",
            "description": "사용한 카드(각성 높은 순, 최대 6장)",
            "items": {
              "type": "string"
            }
          },
          "effects": {
            "type": "array",
            "description": "학습한 세트 효과. 공식 응답에서 아직 보지 못한 단계는 빠집니다",
            "items": {
              "$ref": "#/components/schemas/CardCollectionSetEffectResponse"
            }
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordedBy": {
            "type": "string"
          }
        },
        "required": [
          "activeAwakening",
          "awakening",
          "cardCount",
          "cards",
          "effects",
          "observedAt",
          "recordedBy",
          "setName"
        ]
      },
      "CardCollectionSetEffectResponse": {
        "type": "object",
        "properties": {
          "pieces": {
            "type": "integer",
            "format": "int32"
          },
          "awakening": {
            "type": "integer",
            "format": "int32",
            "description": "각성합계 조건, 없으면 0"
          },
          "description": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "active",
          "awakening",
          "description",
          "pieces"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "ApiResponseCardCollectionRefreshResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CardCollectionRefreshResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CardCollectionRefreshResponse": {
        "type": "object",
        "description": "원정대 카드 기록 채우기 결과",
        "properties": {
          "rosterCharacters": {
            "type": "integer",
            "format": "int32",
            "description": "같은 서버 원정대 캐릭터 수"
          },
          "refreshed": {
            "type": "integer",
            "format": "int32",
            "description": "이번에 조회해 기록한 캐릭터 수"
          },
          "skipped": {
            "type": "integer",
            "format": "int32",
            "description": "최근 7일 안에 이미 기록이 있어 건너뛴 수"
          },
          "failed": {
            "type": "integer",
            "format": "int32",
            "description": "못 찾았거나 공식 오류가 난 수"
          },
          "remaining": {
            "type": "integer",
            "format": "int32",
            "description": "1회 상한(12명)이나 공식 오류로 이번에 못 한 수"
          },
          "nextAvailableAt": {
            "type": "string",
            "format": "date-time",
            "description": "다시 채울 수 있는 시각(10분 쿨다운)"
          }
        },
        "required": [
          "failed",
          "nextAvailableAt",
          "refreshed",
          "remaining",
          "rosterCharacters",
          "skipped"
        ]
      }
    }
  }
}
