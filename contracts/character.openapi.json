{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken character search",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/search": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "캐릭터 검색",
        "description": "프로필, 장비·보석·각인·카드·아크패시브·아크그리드와 원정대를 제공합니다. 기본 캐시는 5분이며 fetchedAt은 실제 외부 수집 완료 시각입니다. null 섹션은 공식 API에서 데이터가 제공되지 않은 경우입니다.",
        "operationId": "search",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "검색할 캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "검색할 캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          }
        ],
        "responses": {
          "200": {
            "description": "캐릭터 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCharacterResponse"
                }
              }
            }
          },
          "400": {
            "description": "캐릭터명 누락 또는 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "406": {
            "description": "NOT_ACCEPTABLE: JSON 이외의 응답 형식 요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "LOST_ARK_RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_SERVER_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "LOST_ARK_API_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "LOST_ARK_NOT_CONFIGURED, CHARACTER_CACHE_UNAVAILABLE 또는 CHARACTER_STORAGE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "LOST_ARK_API_TIMEOUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
