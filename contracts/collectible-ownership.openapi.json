{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken collectible-ownership",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/collectibles/ownership": {
      "get": {
        "tags": [
          "통계·랭킹"
        ],
        "summary": "수집품 항목별 보유율",
        "description": "공식 수집품 항목(CollectiblePoints)마다, activeDays 안에 관측한 원정대(공개 캐릭터가 있는 원정대) 가운데 그 항목을 가진 원정대 수·비율입니다. 분모는 meta.population(원정대 N개)이고, ownedRosters = Point가 0보다 큰 원정대, completedRosters = Point가 만점 이상인 원정대입니다(0/1 항목은 둘이 같음). 항목 키는 (type, name)입니다(공식 문자열 그대로). type을 주면 그 종류만, 없으면 전체 종류(공식 순서)입니다. 모집단이 30 미만이면 sampleStatus=COLLECTING이지만 비율은 그대로 줍니다(참고값). 400 INVALID_REQUEST·STATS_INVALID_RANGE, 503 STATS_UNAVAILABLE",
        "operationId": "ownership",
        "parameters": [
          {
            "name": "server",
            "in": "query",
            "description": "서버 이름. 없으면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "activeDays",
            "in": "query",
            "description": "최근 며칠 안에 관측한 원정대(7·30·90, 기본 30)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "공식 수집품 종류(예: 모코코 씨앗). 없으면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 32,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N} ]+"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCollectibleOwnershipResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, STATS_INVALID_RANGE 또는 STATS_TOO_MANY_BINS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STATS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseCollectibleOwnershipResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CollectibleOwnershipResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
