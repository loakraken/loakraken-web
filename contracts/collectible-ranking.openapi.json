          "unit": {
            "type": "string",
            "description": "ROSTER 또는 CHARACTER(문자열, 값이 늘 수 있음)",
            "example": "ROSTER"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectibleRankingRowResponse"
            }
          }
        }
      },
      "StatsMetaResponse": {
        "type": "object",
        "description": "공통 메타. 모집단은 LOAKraken이 관측한 캐릭터 중 최근 activeDays일 안에 프로필(전투력)을 확인한 캐릭터이며 게임 전체 인구가 아닙니다.",
        "properties": {
          "population": {
            "type": "integer",
            "format": "int64",
            "description": "조건에 맞는 캐릭터 수"
