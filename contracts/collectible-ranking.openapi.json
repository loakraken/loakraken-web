          "aggregatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "snapshot": {
            "type": "string",
            "description": "현재는 latest만 제공합니다",
            "example": "latest"
          },
          "ruleVersion": {
            "type": "string",
            "example": "stats-v1"
          },
          "minSample": {
            "type": "integer",
            "format": "int32",
            "example": 30
          },
          "sampleStatus": {
            "type": "string",
            "description": "COLLECTING(표본 30명 미만) 또는 READY",
            "enum": [
              "COLLECTING",
              "READY"
            ]
          },
          "coverage": {
            "$ref": "#/components/schemas/StatsCoverageResponse"
          },
          "populationUnit": {
            "type": "string",
            "description": "population을 세는 단위(#295): CHARACTER(캐릭터), ROSTER(원정대), GUILD(길드). 문자열이며 값이 늘 수 있음",
            "example": "CHARACTER"
          }
        },
        "required": [
          "aggregatedAt",
          "conditions",
          "coverage",
          "minSample",
          "population",
          "populationUnit",
          "ruleVersion",
          "sampleStatus",
          "snapshot"
        ]
      },
