{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken collectible-ranking",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/rankings/collectibles": {
      "get": {
        "tags": [
          "통계·랭킹"
        ],
        "summary": "수집품(내실) 랭킹",
        "description": "공식 수집품(collectibles)의 Point·MaxPoint로 만든 진행도(Σ Point / Σ MaxPoint × 100) 순위입니다. 수집품은 원정대가 함께 모으므로 기본은 원정대 단위(대표 = 아이템 레벨이 가장 높은 공개 캐릭터)이고, unit=CHARACTER면 같은 원정대 캐릭터마다 같은 값으로 한 행씩 나옵니다. 동률은 진행도 → Σ Point 순이고, 같으면 같은 순위입니다. 하나도 모으지 않은 원정대와 activeDays 안에 관측하지 않은 원정대는 빠집니다. 공개 제외 캐릭터는 대표·행·캐릭터 수에서 빠지고, 공개 캐릭터가 없는 원정대는 빠집니다. 모집단이 30 미만이면 sampleStatus=COLLECTING이지만 값·순위는 그대로 줍니다(참고값). 400 INVALID_REQUEST·STATS_INVALID_RANGE, 503 STATS_UNAVAILABLE",
        "operationId": "collectibles",
        "parameters": [
          {
            "name": "server",
            "in": "query",
            "description": "서버 이름. 없으면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "activeDays",
            "in": "query",
            "description": "최근 며칠 안에 관측한 원정대(7·30·90, 기본 30)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "unit",
            "in": "query",
            "description": "ROSTER(기본, 원정대) 또는 CHARACTER(캐릭터)",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "ROSTER|CHARACTER"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "1부터",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 201,
              "minimum": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "페이지 크기(기본 50, 최대 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCollectibleRankingResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, STATS_INVALID_RANGE 또는 STATS_TOO_MANY_BINS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STATS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseCollectibleRankingResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CollectibleRankingResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CollectibleRankingResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/StatsMetaResponse"
