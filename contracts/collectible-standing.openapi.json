{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken collectible-standing",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/rankings/collectibles/standing": {
      "get": {
        "tags": [
          "통계·랭킹"
        ],
        "summary": "캐릭터 기준 수집품 순위",
        "description": "그 캐릭터 원정대의 수집품 랭킹 순위·전체·상위 %·진행도입니다. 모집단·정렬·동률은 수집품 랭킹과 같습니다. 순위에 없으면 rank 등은 null이고 reason에 이유 코드(문자열, 값이 늘 수 있음)를 줍니다: EXCLUDED(공개 제외, 관측 여부도 숨김), NOT_OBSERVED(캐릭터·원정대·수집품 관측 없음), INACTIVE(activeDays 안 관측 없음), NO_COLLECTIBLES(모은 수집품 없음). 모집단이 30 미만이면 topPercent는 null이고 rank는 그대로 줍니다(참고값). 400 INVALID_REQUEST·STATS_INVALID_RANGE, 503 STATS_UNAVAILABLE",
        "operationId": "standing",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "캐릭터 이름",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 1,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "server",
            "in": "query",
            "description": "서버 이름. 없으면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "activeDays",
            "in": "query",
            "description": "최근 며칠 안에 관측한 원정대(7·30·90, 기본 30)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "unit",
            "in": "query",
            "description": "ROSTER(기본, 원정대) 또는 CHARACTER(캐릭터)",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "ROSTER|CHARACTER"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCollectibleStandingResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, STATS_INVALID_RANGE 또는 STATS_TOO_MANY_BINS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STATS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
