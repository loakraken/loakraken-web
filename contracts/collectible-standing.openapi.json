          },
          "serverName": {
            "anyOf": [
              {
                "type": "string",
                "description": "서버 이름(공개 제외·관측 없음이면 null)"
              },
              {
                "type": "null"
              }
            ]
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int64",
                "description": "같은 값은 같은 순위. 순위에 없으면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "같은 조건의 순위 모집단 수"
          },
          "topPercent": {
            "anyOf": [
              {
                "type": "number",
                "description": "상위 몇 %(소수 둘째 자리 올림, 다른 통계와 같음). 모집단 30 미만이거나 순위가 없으면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "progressPercent": {
            "anyOf": [
              {
                "type": "number",
                "description": "Σ Point / Σ MaxPoint × 100, 소수 둘째 자리. 순위가 없으면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "point": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxPoint": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "description": "순위에 없는 이유(문자열, 값이 늘 수 있음): EXCLUDED, NOT_OBSERVED, INACTIVE, NO_COLLECTIBLES. 순위가 있으면 null",
                "example": "INACTIVE"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "characterName",
          "maxPoint",
          "meta",
          "point",
          "progressPercent",
          "rank",
          "reason",
          "serverName",
          "topPercent",
          "total",
          "unit"
