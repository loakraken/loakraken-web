              "READY"
            ]
          },
          "coverage": {
            "$ref": "#/components/schemas/StatsCoverageResponse"
          },
          "populationUnit": {
            "type": "string",
            "description": "population을 세는 단위(#295): CHARACTER(캐릭터), ROSTER(원정대), GUILD(길드). 문자열이며 값이 늘 수 있음",
            "example": "CHARACTER"
