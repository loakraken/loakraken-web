{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken combat-power",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/combat-power/simulate": {
      "post": {
        "tags": [
          "캐릭터"
        ],
        "summary": "전투력 시뮬레이션(공식 호출 없음)",
        "description": "캐릭터 캐시의 현재 세팅에 바꾼 항목(changes)을 순서대로 적용합니다. 같은 대상은 뒤의 변경이 이깁니다. after는 바꾼 항목을 함께 적용한 값이고 contributions[].delta는 순서대로 하나씩 적용했을 때의 증가분입니다(합 = delta). 계산식이 확정되지 않은 항목은 status=UNSUPPORTED이고 delta=null이며 after에 들어가지 않습니다(partial=true). 반올림은 서버에서 끝냅니다(전투력 소수 둘째 자리, deltaPercent % 소수 셋째 자리).",
        "operationId": "simulate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CombatPowerSimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "CHARACTER_COMBAT_POWER_SIMULATE_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCombatPowerSimulationResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: 범위 밖·모르는 kind·필수 값 없음(메시지에 필드와 허용 범위). KARMA_POINTS_OUT_OF_RANGE: karmaRank를 바꾸면 그 트리 포인트 합이 깨달음 0~101·도약 0~70을 벗어남(자르지 않음, 랭크 자체가 0~6 밖이면 INVALID_REQUEST)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_CACHED: 캐릭터 캐시 없음(공식 호출 없음)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "CHANGE_TARGET_NOT_FOUND: 캐시가 바뀌어 바꿀 대상이 캐릭터에 없음(다시 불러오기)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/characters/combat-power/options": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "전투력 시뮬레이터 입력 범위",
        "description": "화면 입력의 허용 범위입니다. verified=false면 숫자 범위가 공식 근거로 확정되기 전 예시입니다.",
        "operationId": "options_1",
        "responses": {
          "200": {
            "description": "CHARACTER_COMBAT_POWER_OPTIONS_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCombatPowerOptionsResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/characters/combat-power/contributions": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "장착 항목의 전투력 기여(공식 호출 없음)",
        "description": "그 항목을 뺐을 때 공식 전투력이 몇 % 줄어드는지입니다(전투력 기여 % = 1 − 뺀 전투력 / 지금 전투력). 지금은 팔찌(효과 줄 전부 + 팔찌 도약 포인트)만 주고, kind는 문자열이라 늘어날 수 있습니다. 계산할 수 없으면 status=UNSUPPORTED이고 contributionPct=null입니다.",
        "operationId": "contributions",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 0,
              "pattern": "\\s*[\\p{L}\\p{N}]+\\s*"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CHARACTER_COMBAT_POWER_CONTRIBUTIONS_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCombatPowerContributionsResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_CACHED: 캐릭터 캐시 없음(공식 호출 없음)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/characters/combat-power/gem-ranking": {
      "post": {
        "tags": [
          "캐릭터"
        ],
        "summary": "아크 그리드 젬 교체 순위(공식 호출 없음)",
        "description": "딜러의 장착 젬 칸마다 그 코어 계열의 세 종류 × 효과 정책(ALL·A_OR_B·A·A_AND_B, A·B는 그 종류의 딜러 옵션 두 개) × 초기화로, 새 젬을 사서 '네 옵션 포인트 합이 targetTotal 이상이 되면 완료' 정책으로 가공했을 때 이 칸에 넣어 전투력이 오르고 의지력이 맞고 정책 효과를 만족할 확률(successProbability, 0~1), 성공할 때의 기대 전투력 증가(expectedGainPct, %, 시뮬레이터 deltaPercent와 같은 단위), 기대 비용(구성 요소 모두 젬 여러 개를 산 전체 기대값이고 합이 total)을 줍니다. targetTotal은 확률이 가장 큰 목표 합입니다. 성공 확률이 0인 줄은 주지 않습니다. 순위: goldPerPercent 오름차순(같으면 확률 높은 쪽), 비용이 없는 줄은 그 뒤에 expectedGainPct × successProbability 내림차순. 젬 가격은 거래소 시세 캐시(1개 즉시 구매 최저가)만 읽고, 페온 1개 골드·초기화권 가격은 요청 값입니다. 서포터·판정 불가는 status UNSUPPORTED와 빈 rows. slotIndex·gemIndex는 공식 ArkGrid Slots·Gems Index(0부터)로 캐릭터 응답과 같습니다. policy·gemType·grade·missingPrices·status·reasonCode는 문자열이며 값이 늘 수 있습니다.",
        "operationId": "rank",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GemRankingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "GEM_RANKING_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseGemRankingResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: 등급·정책·초기화·가격·limit 값",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_CACHED: 캐릭터를 먼저 검색해야 함. 스위치(combat-power-sim.gem-ranking.enabled)가 꺼져 있으면 이 경로가 없어 404",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "GEM_RANKING_BUSY: 순위 계산 자리가 모두 차 있음(기다리지 않음, Retry-After 초 뒤 다시) / CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CombatPowerSimulationRequest": {
        "type": "object",
        "properties": {
          "characterName": {
            "type": "string",
            "description": "캐릭터명",
            "example": "모험가",
            "maxLength": 16,
            "minLength": 0,
            "pattern": "\\s*[\\p{L}\\p{N}]+\\s*"
          },
          "changes": {
            "type": "array",
            "description": "바꾼 항목(순서대로 적용, 최대 64개)",
            "items": {
              "$ref": "#/components/schemas/ChangeRequest"
            },
            "maxItems": 64,
            "minItems": 0
          }
        },
        "required": [
          "changes",
          "characterName"
        ]
      },
      "ChangeRequest": {
        "type": "object",
        "description": "바꾼 항목 하나. kind마다 쓰는 필드가 다르다",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "GEM_LEVEL_ALL",
              "GEM_LEVEL",
              "EQUIPMENT_REFINE",
              "EQUIPMENT_ADVANCED_REFINE",
              "EQUIPMENT_QUALITY",
              "POLISH",
              "BRACELET_EFFECT",
              "ENGRAVING_LEVEL",
              "STONE_ENGRAVING",
              "ARK_PASSIVE_POINT",
              "ARK_GRID_CORE",
              "ARM_GUARD",
              "ARK_GRID_GEM"
            ]
          },
          "slot": {
            "type": "integer",
            "format": "int32",
            "description": "보석 slot(GEM_LEVEL, 0~10). 보석이 없는 빈 칸이면 그 칸에 4티어 보석을 새로 끼우는 변화로 계산한다(before = 0)"
          },
          "index": {
            "type": "integer",
            "format": "int32",
            "description": "검색 응답 loadout.equipment 순번(EQUIPMENT_*·POLISH)"
          },
          "line": {
            "type": "integer",
            "format": "int32",
            "description": "연마·팔찌 효과 줄 번호(0부터)"
          },
          "level": {
            "type": "integer",
            "format": "int32",
            "description": "보석 레벨(0은 보석 빼기)·상급 재련 단계·각인·스톤 레벨"
          },
          "refine": {
            "type": "integer",
            "format": "int32",
            "description": "재련 단계(EQUIPMENT_REFINE)"
          },
          "quality": {
            "type": "integer",
            "format": "int32",
            "description": "품질(EQUIPMENT_QUALITY)"
          },
          "option": {
            "type": "string",
            "description": "연마 옵션 이름(POLISH, options의 polishValues.options[].option). 같은 부위에 같은 이름의 %·고정값이 둘 다 있으면(귀걸이 공격력·무기 공격력) % 쪽은 끝에 \" %\"를 붙인다(예: \"공격력 %\"). \"NONE\"은 점수 옵션이 없는 줄(전투력 몫 0, grade 없음): 스펙업 추천 순서의 연마 단계가 사는 장신구에서 빠지는 줄(지금 고정값 줄)을 나타낸다.",
            "maxLength": 32,
            "minLength": 0
          },
          "grade": {
            "type": "string",
            "description": "LOW·MID·HIGH(POLISH·BRACELET_EFFECT, POLISH option NONE이면 없음), 코어 등급(ARK_GRID_CORE)",
            "maxLength": 8,
            "minLength": 0
          },
          "name": {
            "type": "string",
            "description": "팔찌 효과·각인·스톤 각인 이름",
            "maxLength": 32,
            "minLength": 0
          },
          "tree": {
            "type": "string",
            "description": "아크 패시브 트리(진화·깨달음·도약)",
            "maxLength": 8,
            "minLength": 0
          },
          "points": {
            "type": "integer",
            "format": "int32",
            "description": "아크 패시브 포인트(0~999, 도약은 0~70)"
          },
          "slotIndex": {
            "type": "integer",
            "format": "int32",
            "description": "아크 그리드 slot index(ARK_GRID_CORE·ARK_GRID_GEM, 공식 ArkGrid.Slots Index)"
          },
          "point": {
            "type": "integer",
            "format": "int32",
            "description": "아크 그리드 코어 포인트(ARK_GRID_CORE 0~20), 새 젬 포인트(ARK_GRID_GEM 1~5)"
          },
          "karmaLevel": {
            "type": "integer",
            "format": "int32",
            "description": "카르마 레벨(0~30, ARK_PASSIVE_POINT tree 깨달음·도약, points·karmaRank·level과 함께 쓰지 않음). 깨달음은 무기 공격력 레벨당 +0.1%, 도약은 × (1 + 0.0002 × 레벨) 모델값. 진화는 400. 딜러만 계산한다"
          },
          "karmaRank": {
            "type": "integer",
            "format": "int32",
            "description": "카르마 랭크(0~6, ARK_PASSIVE_POINT tree 진화·깨달음·도약, points·karmaLevel·level과 함께 쓰지 않음). 깨달음은 랭크마다 포인트 +1, 도약은 +2(같은 요청의 앞 변경 뒤 포인트에 더하고, 깨달음 0~101·도약 0~70 밖이면 400), 진화는 × (1 + 0.006 × 랭크) 모델값. 같은 트리의 points 변경이 랭크 변경보다 뒤에 오면 그 points가 포인트 합을 정한다(랭크로 옮긴 포인트를 덮음). 딜러만 계산한다"
          },
          "gemType": {
            "type": "string",
            "description": "새 젬 종류(ARK_GRID_GEM): 질서 코어는 안정·견고·불변, 혼돈 코어는 침식·왜곡·붕괴. 바꿀 젬은 index(공식 Gems Index). 종류별 옵션 4종(effects[].name, 공식 확률 정보·공지 13204): 안정·침식 = 공격력·추가 피해·아군 피해 강화·낙인력, 견고·왜곡 = 공격력·보스 피해·아군 피해 강화·아군 공격 강화, 불변·붕괴 = 추가 피해·보스 피해·낙인력·아군 공격 강화. 필요 의지력 기본값 안정·침식 8, 견고·왜곡 9, 불변·붕괴 10. 바꾼 뒤 그 코어의 의지력이 모자라면 그 줄은 UNSUPPORTED, reasonCode ARK_GRID_WILL_SHORT(basis에 한국어 문장)",
            "maxLength": 4,
            "minLength": 0
          },
          "willEfficiency": {
            "type": "integer",
            "format": "int32",
            "description": "새 젬 의지력 효율(ARK_GRID_GEM 1~5). 필요 의지력 = 종류 기본값(8·9·10) − 효율"
          },
          "effects": {
            "type": "array",
            "description": "새 젬 옵션 두 줄(ARK_GRID_GEM): 그 종류의 옵션 4종 중 서로 다른 둘, 레벨 1~5",
            "items": {
              "$ref": "#/components/schemas/GemOptionRequest"
            },
            "maxItems": 2,
            "minItems": 0
          }
        },
        "required": [
          "kind"
        ]
      },
      "GemOptionRequest": {
        "type": "object",
        "description": "젬 옵션 한 줄(ARK_GRID_GEM)",
        "properties": {
          "name": {
            "type": "string",
            "description": "옵션 이름(공격력·추가 피해·보스 피해·아군 피해 강화·아군 공격 강화·낙인력)",
            "maxLength": 16,
            "minLength": 0
          },
          "level": {
            "type": "integer",
            "format": "int32",
            "description": "옵션 레벨 1~5"
          }
        }
      },
      "ApiResponseCombatPowerSimulationResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CombatPowerSimulationResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CombatPowerSimulationResponse": {
        "type": "object",
        "properties": {
          "ruleVersion": {
            "type": "string",
            "description": "계산 규칙 버전(문자열)"
          },
          "characterName": {
            "type": "string"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "description": "현재 세팅을 읽은 캐릭터 캐시의 수집 시각(검색 응답 fetchedAt과 비교)"
          },
          "before": {
            "anyOf": [
              {
                "type": "number",
                "description": "공식 전투력(armory CombatPower). 없으면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "modelBefore": {
            "anyOf": [
              {
                "type": "number",
                "description": "현재 세팅의 모델값(검증용, 화면 표시 안 함). 계산식 확정 전 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "number",
                "description": "바꾼 항목을 함께 적용한 전투력(계산된 항목만). 2부 대비 막기(모든 줄 GAME_UPDATE_UNSUPPORTED)면 delta·deltaPercent와 함께 null"
              },
              {
