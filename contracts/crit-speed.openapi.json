                "type": "null"
              }
            ]
          },
          "observedRate": {
            "type": "number"
          },
          "assumedRate": {
            "type": "number"
          },
          "totalRate": {
            "type": "number",
            "description": "관측+가정 치명타 적중률(상한 적용 전)"
          },
          "effectiveRate": {
            "type": "number",
            "description": "실제 적용 치명타 적중률. 뭉툭한 가시 장착 시 그 상한, 아니면 100%"
          },
          "bluntThorn": {
            "$ref": "#/components/schemas/CritSpeedBluntThornResponse"
          },
          "targets": {
            "type": "array",
            "description": "CRIT_100: 치적 100%, BLUNT_THORN_OPTIMAL: 뭉툭한 가시 최대 진화형 피해 도달",
            "items": {
              "$ref": "#/components/schemas/CritSpeedTargetResponse"
            }
          },
          "critStatPerPercent": {
            "type": "number",
            "description": "치명타 적중률 1%당 치명 스탯(27.944)"
          },
          "damage": {
            "$ref": "#/components/schemas/CritSpeedCritDamageResponse",
            "description": "치명타 피해(%). 기본 200 + 관측 출처(axis=CRIT_DAMAGE) 합. 스킬 한정 문구 제외"
          }
        },
        "required": [
          "assumedRate",
          "bluntThorn",
          "critStat",
          "critStatPerPercent",
          "damage",
          "effectiveRate",
          "observedRate",
          "targets",
          "totalRate"
        ]
      },
      "CritSpeedBluntThornResponse": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
