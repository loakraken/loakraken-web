      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CritSpeedSkillResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "attackType": {
            "anyOf": [
              {
                "type": "string",
                "description": "BACK_ATTACK·HEAD_ATTACK·NONE. 모르면 null",
                "enum": [
                  "BACK_ATTACK",
                  "HEAD_ATTACK",
                  "NONE"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "base": {
            "type": "number",
            "description": "crit.observedRate"
          },
          "backAttack": {
            "anyOf": [
              {
                "type": "number",
                "description": "백 어택이면 10, 아니면 0. 공격 타입을 모르면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "tripod": {
            "anyOf": [
              {
                "type": "number",
                "description": "선택 트라이포드 치명타 적중률 합. 갱신 전 캐시라 문구가 없으면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "anyOf": [
              {
                "type": "number",
                "description": "base + backAttack + tripod. 하나라도 null이면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective": {
            "anyOf": [
              {
                "type": "number",
                "description": "total에 상한(100, 뭉툭한 가시 장착 시 그 상한) 적용"
              },
              {
                "type": "null"
              }
            ]
          },
          "tripods": {
            "type": "array",
            "description": "합산한 트라이포드",
            "items": {
              "$ref": "#/components/schemas/CritSpeedSkillTripodResponse"
            }
          },
          "conditional": {
            "type": "array",
            "description": "조건부 문구('…시', '…의 치명타 적중률')라 합산하지 않은 트라이포드",
            "items": {
              "$ref": "#/components/schemas/CritSpeedSkillTripodResponse"
            }
          },
          "node": {
            "type": "number",
            "description": "이 스킬에만 붙는 아크 패시브 노드 치명타 적중률 합(예: 관통 필살 → 적룡필살)"
          },
          "nodes": {
            "type": "array",
            "description": "합산한 스킬 한정 노드(공식 문구 포함)",
            "items": {
              "$ref": "#/components/schemas/CritSpeedSkillTripodResponse"
            }
          },
          "damage": {
            "type": "number",
            "description": "이 스킬의 치명타 피해(%): 기본 치명타 피해(crit.damage.total) + 이 스킬에만 붙는 노드(예: 분노의 망치 → 해방 스킬)"
          },
          "damageNodes": {
            "type": "array",
            "description": "합산한 스킬 한정 치명타 피해 노드(공식 문구 포함)",
            "items": {
              "$ref": "#/components/schemas/CritSpeedSkillTripodResponse"
            }
          }
        },
        "required": [
          "attackType",
          "backAttack",
          "base",
          "conditional",
          "damage",
          "damageNodes",
          "effective",
          "name",
          "node",
          "nodes",
          "total",
          "tripod",
          "tripods"
        ]
      },
      "CritSpeedSkillTripodResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "description": "치명타 적중률 증가(%)"
          },
          "text": {
            "type": "string",
            "description": "공식 트라이포드 효과 문구"
          }
        },
        "required": [
          "name",
          "text",
          "value"
        ]
      },
      "CritSpeedToggleResponse": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "요청 assumptions.toggles 키(노드 이름 또는 버프 이름)"
          },
          "label": {
            "type": "string",
            "description": "화면 표시 이름(예: 악마화 상태 가정)"
          },
          "coreState": {
            "type": "boolean",
            "description": "직업 핵심 상태·자기 버프면 true(기본 켬), 상황 조건이면 false(기본 끔)"
          },
          "on": {
            "type": "boolean",
            "description": "이번 계산에서 켰는지"
          },
          "value": {
            "type": "number",
            "description": "켜면 더하는 치명타 적중률(%)"
          },
          "text": {
            "type": "string",
            "description": "공식 원문 또는 근거"
          }
        },
        "required": [
          "coreState",
          "key",
          "label",
          "on",
          "text",
          "value"
        ]
      }
    }
  }
}
