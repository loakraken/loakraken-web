            "description": "상한 초과 치적의 진화형 피해 전환 비율 %"
          },
          "maxEvolutionDamage": {
            "type": "number"
          },
          "optimalCritRate": {
            "type": "number"
          },
          "evolutionDamage": {
            "type": "number",
            "description": "현재 totalRate에서의 노드 진화형 피해"
          },
          "effectiveCritRate": {
            "type": "number",
            "description": "노드 장착 시 적용 치적"
          }
        },
        "required": [
          "baseEvolutionDamage",
          "conversionPercent",
          "critCap",
          "effectiveCritRate",
          "evolutionDamage",
          "level",
          "maxEvolutionDamage",
          "optimalCritRate",
          "source"
        ]
      },
      "CritSpeedTargetResponse": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "targetRate": {
            "type": "number"
          },
          "requiredCritStat": {
            "anyOf": [
              {
                "type": "integer",
