        "required": [
          "axis",
          "category",
          "kind",
          "name",
          "text",
          "value"
        ]
      },
      "CritSpeedCritResponse": {
        "type": "object",
        "properties": {
          "critStat": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "프로필 치명 스탯. 알 수 없으면 null"
