{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken crit-speed",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/crit-speed": {
      "post": {
        "tags": [
          "캐릭터"
        ],
        "summary": "치명타·공이속 계산(치적·뭉가·음돌)",
        "description": "캐릭터 검색 캐시를 공유해 공식 원문(치명·신속 Tooltip, 각인, 아크 패시브 노드, 장신구 연마, 팔찌, 카드)의 치명타 적중률과 공격·이동 속도를 합산하고, 요청 가정(백어택·펫·시너지·버프 등)을 분리해 더합니다. 치적 100%·뭉툭한 가시 최적 치적까지 필요한 치명과 음속 돌파 최적 속도까지 필요한 신속을 계산합니다. 원정대는 조회하지 않습니다.",
        "operationId": "critSpeed",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CritSpeedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "계산 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCritSpeedResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: 캐릭터명·가정 범위 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "LOST_ARK_RATE_LIMITED / CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "LOST_ARK_API_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "LOST_ARK_NOT_CONFIGURED 또는 CHARACTER_CACHE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "LOST_ARK_API_TIMEOUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CritSpeedRequest": {
        "type": "object",
        "properties": {
          "characterName": {
            "type": "string",
            "description": "계산할 캐릭터명",
            "example": "모험가",
            "maxLength": 64,
            "minLength": 0,
            "pattern": "\\s*[\\p{L}\\p{N}]+\\s*"
          },
          "assumptions": {
            "$ref": "#/components/schemas/CritSpeedAssumptions",
            "description": "파티·버프·조건 가정. 생략하면 모든 가정 없음(관측값만)"
          }
        },
        "required": [
          "characterName"
        ]
      },
      "CritSpeedAssumptions": {
        "type": "object",
        "description": "% 단위 가정. 생략한 값은 0 또는 false",
        "properties": {
          "backAttack": {
            "type": "boolean",
            "description": "백어택 적중 가정(치명타 적중률 +10%)"
          },
          "critPet": {
            "type": "boolean",
            "description": "치명 펫 효과(치명 +160)"
          },
          "critSynergyCount": {
            "type": "integer",
            "format": "int32",
            "description": "치명타 적중률 시너지 수(동일 직업 제외, 1개당 +10%)",
            "maximum": 3,
            "minimum": 0
          },
          "supportCritRate": {
            "type": "number",
            "description": "서포터 치명타 적중률 버프 %",
            "maximum": 30,
            "minimum": 0
          },
          "tripodCritRate": {
            "type": "number",
            "description": "사용 스킬 트라이포드 치명타 적중률 %",
            "maximum": 100,
            "minimum": 0
          },
          "extraCritRate": {
            "type": "number",
            "description": "기타 치명타 적중률 가정 %(아크 그리드 코어 등)",
            "maximum": 100,
            "minimum": 0
          },
          "extraAttackSpeed": {
            "type": "number",
            "description": "공격 속도 가정 %(직업 각인·트라이포드·서포터 버프·만찬·음식 합). 감소는 음수",
            "maximum": 100,
            "minimum": -100
          },
          "extraMoveSpeed": {
            "type": "number",
            "description": "이동 속도 가정 %(직업 각인·트라이포드·서포터 버프·만찬·음식 합). 감소는 음수",
            "maximum": 100,
            "minimum": -100
          },
          "classState": {
            "type": "boolean",
            "description": "직업 상태 가정(예: 리퍼 갈증 '피냄새' 혼돈 상태 치명타 적중률). 생략하면 켬(목표 사이트와 같은 기준). false면 관측값만"
          },
          "toggles": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "효과별 켜기·끄기(응답 toggles[].key). 생략한 효과는 기본값: 직업 핵심 상태·자기 버프는 classState, 상황 조건(스킬 직후 N초 등)은 끔"
          }
        }
      },
      "ApiResponseCritSpeedResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CritSpeedResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CritSpeedResponse": {
        "type": "object",
        "description": "치명타·공이속 계산. 관측(OBSERVED)과 가정(ASSUMED) 출처를 분리합니다. 값은 % 단위입니다.",
        "properties": {
          "ruleVersion": {
            "type": "string",
            "description": "계산 규칙 버전"
          },
          "characterName": {
            "type": "string"
          },
          "className": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "description": "캐릭터 원천 수집 시각(캐시 적중 시 원래 시각)"
          },
          "sources": {
            "type": "array",
            "description": "합산한 출처. text는 공식 원문 또는 가정 설명",
            "items": {
              "$ref": "#/components/schemas/CritSpeedSourceResponse"
            }
          },
          "crit": {
            "$ref": "#/components/schemas/CritSpeedCritResponse"
          },
          "speed": {
            "$ref": "#/components/schemas/CritSpeedSpeedResponse"
          },
          "limitations": {
            "type": "array",
            "description": "계산에서 제외했거나 근사한 항목",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "description": "스킬별 치명타 적중률(레벨 2 이상 스킬, 이름순). base(crit.observedRate) + 백 어택 +10 + 선택 트라이포드 치명타 적중률 합. 가정 입력은 더하지 않는다",
            "items": {
              "$ref": "#/components/schemas/CritSpeedSkillResponse"
            }
          },
          "toggles": {
            "type": "array",
            "description": "켜고 끌 수 있는 효과(이 캐릭터에 해당하는 것만). 요청 assumptions.toggles에 key로 넣어 바꾼다. coreState=true는 기본 켬",
            "items": {
              "$ref": "#/components/schemas/CritSpeedToggleResponse"
            }
          }
        },
        "required": [
          "characterName",
          "className",
          "crit",
          "fetchedAt",
          "limitations",
          "ruleVersion",
          "skills",
          "sources",
          "speed",
          "toggles"
        ]
      },
