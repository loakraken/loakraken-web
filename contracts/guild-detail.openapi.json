{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken guild-detail",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/guilds/{serverName}/{guildName}": {
      "get": {
        "tags": [
          "통계·랭킹"
        ],
        "summary": "길드 탭 집계",
        "description": "한 길드에서 최근 activeDays일 안에 프로필을 관측한 공개 길드원(길드 랭킹 memberCount와 같은 정의)으로 만든 목록·평균·중앙값·분포·직업 분포입니다(guild-detail-v1). 표본 방식이라 실제 길드 전체가 아닙니다. 길드 이름은 대소문자를 무시해 찾습니다. 처리정지 캐릭터는 목록·집계 모두에 없습니다. 길드원이 5명 미만이면 sampleStatus=SMALL이지만 값은 그대로 줍니다. 관측 길드원이 없으면 404 STATS_GUILD_NOT_OBSERVED입니다. 400 INVALID_REQUEST, 404 STATS_GUILD_NOT_OBSERVED, 503 STATS_UNAVAILABLE",
        "operationId": "guild",
        "parameters": [
          {
            "name": "serverName",
            "in": "path",
            "description": "서버 이름",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 1,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "guildName",
            "in": "path",
            "description": "길드 이름(1~12자, 글자·숫자)",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 12,
              "minLength": 1,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "activeDays",
            "in": "query",
            "description": "최근 며칠 안에 프로필을 관측한 길드원(7·30·90, 기본 30)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseGuildDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, STATS_INVALID_RANGE 또는 STATS_TOO_MANY_BINS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STATS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseGuildDetailResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/GuildDetailResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "GuildDetailResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/GuildDetailMeta"
          },
          "serverName": {
            "type": "string"
          },
          "guildName": {
            "type": "string",
            "description": "저장된 길드 이름 철자"
          },
          "summary": {
            "$ref": "#/components/schemas/GuildDetailSummary"
          },
          "classes": {
            "type": "array",
            "description": "인원 많은 순, 같으면 직업 이름순",
            "items": {
              "$ref": "#/components/schemas/GuildClassCount"
            }
          },
          "itemLevelBins": {
            "type": "array",
            "description": "아이템 레벨 구간(폭 10), 낮은 구간부터",
            "items": {
              "$ref": "#/components/schemas/GuildBin"
            }
          },
          "combatPowerBins": {
            "type": "array",
            "description": "전투력 구간(폭 100), 전투력을 관측한 길드원만",
            "items": {
              "$ref": "#/components/schemas/GuildBin"
            }
          },
          "members": {
            "type": "array",
            "description": "아이템 레벨 높은 순, 같으면 이름순. 전원",
            "items": {
              "$ref": "#/components/schemas/GuildMemberResponse"
            }
          }
        },
        "required": [
          "classes",
          "combatPowerBins",
          "guildName",
          "itemLevelBins",
          "members",
          "meta",
          "serverName",
          "summary"
        ]
      },
      "GuildDetailMeta": {
        "type": "object",
        "properties": {
          "memberCount": {
            "type": "integer",
            "format": "int64",
            "description": "관측한 공개 길드원 수(실제 길드 인원이 아님)",
            "example": 12
          },
          "sampleStatus": {
            "type": "string",
            "description": "SMALL(길드원 minMembers 미만) 또는 READY. 문자열이며 값이 늘 수 있음",
            "example": "READY"
          },
          "minMembers": {
            "type": "integer",
            "format": "int32",
            "description": "길드 랭킹에 넣는 최소 길드원 수",
            "example": 5
          },
          "activeDays": {
            "type": "integer",
            "format": "int32",
            "example": 30
          },
          "aggregatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ruleVersion": {
            "type": "string",
            "example": "guild-detail-v1"
          }
        },
        "required": [
          "activeDays",
          "aggregatedAt",
          "memberCount",
          "minMembers",
          "ruleVersion",
          "sampleStatus"
        ]
      },
      "GuildDetailSummary": {
        "type": "object",
        "description": "소수 둘째 자리. 전투력 값은 전투력을 관측한 길드원(combatPowerCount)만으로 냄",
        "properties": {
          "itemLevelAvg": {
            "type": "number"
          },
          "itemLevelMedian": {
            "type": "number"
          },
          "itemLevelMax": {
            "type": "number"
          },
          "itemLevelMin": {
            "type": "number"
          },
          "combatPowerAvg": {
            "anyOf": [
              {
                "type": "number",
                "description": "전투력을 관측한 길드원이 없으면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "combatPowerMedian": {
            "anyOf": [
              {
                "type": "number",
                "description": "전투력을 관측한 길드원이 없으면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "combatPowerCount": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "combatPowerAvg",
          "combatPowerCount",
          "combatPowerMedian",
          "itemLevelAvg",
          "itemLevelMax",
          "itemLevelMedian",
          "itemLevelMin"
        ]
      },
      "GuildClassCount": {
        "type": "object",
        "properties": {
          "className": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "format": "int64"
          },
          "share": {
            "type": "number",
            "description": "길드원 대비 %, 소수 둘째 자리",
            "example": 25
          }
        },
        "required": [
          "className",
          "count",
          "share"
        ]
      },
      "GuildBin": {
        "type": "object",
        "properties": {
          "from": {
            "type": "number",
            "description": "구간 아래 끝(포함)"
          },
          "count": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "count",
          "from"
        ]
      },
      "GuildMemberResponse": {
        "type": "object",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "itemLevel": {
            "type": "number"
          },
          "combatPower": {
            "anyOf": [
              {
                "type": "number",
                "description": "관측한 전투력(없으면 null)"
              },
              {
                "type": "null"
              }
            ]
          },
          "guildMemberGrade": {
            "anyOf": [
              {
                "type": "string",
                "description": "공식 길드 직위 문자열 그대로(아직 확인 못 했으면 null). 문자열이며 값이 늘 수 있음",
                "example": "길드원"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "description": "마지막 프로필 관측 시각(분 단위)"
          },
          "rosterGroup": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "이 응답 안에서만 쓰는 원정대 묶음 번호(1부터). 같은 원정대(같은 계정) 길드원은 같은 번호이고, 이 길드에 혼자인 캐릭터도 자기 번호 하나를 받습니다. 묶음 인원 많은 순 → 묶음 최고 아이템 레벨 높은 순 → 이름순으로 매기며, 응답마다 새로 매기므로 다른 응답의 번호와 이어지지 않습니다. 원정대를 모르면 null",
                "example": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "characterName",
          "className",
          "combatPower",
          "guildMemberGrade",
          "itemLevel",
          "observedAt",
          "rosterGroup"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
