{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken guild-ranking",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/rankings/guilds": {
      "get": {
        "tags": [
          "통계·랭킹"
        ],
        "summary": "길드 랭킹",
        "description": "같은 서버·같은 길드 이름(공식 프로필 GuildName)의 관측 캐릭터를 묶은 순위입니다. activeDays 안에 프로필을 관측한 공개 캐릭터만 넣으므로 값은 실제 길드 전체가 아니라 확인한 길드원 기준입니다. sort: AVG(아이템 레벨 평균, 기본) 또는 SUM(아이템 레벨 합). 확인한 길드원이 minMembers(5명) 미만인 길드는 빼고 excludedGuilds에 수를 줍니다. 처리정지 목록는 캐릭터만 빼고 길드는 빼지 않습니다. 값이 같으면(소수 둘째 자리) 같은 순위입니다. 모집단이 30 미만이면 sampleStatus=COLLECTING이지만 값·순위는 그대로 줍니다(참고값). 400 INVALID_REQUEST·STATS_INVALID_RANGE, 503 STATS_UNAVAILABLE",
        "operationId": "guilds",
        "parameters": [
          {
            "name": "server",
            "in": "query",
            "description": "서버 이름. 없으면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "activeDays",
            "in": "query",
            "description": "최근 며칠 안에 프로필을 관측한 캐릭터(7·30·90, 기본 30)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "AVG(기본) 또는 SUM",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "AVG|SUM"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "1부터",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 201,
              "minimum": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "페이지 크기(기본 50, 최대 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseGuildRankingResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, STATS_INVALID_RANGE 또는 STATS_TOO_MANY_BINS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STATS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseGuildRankingResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
