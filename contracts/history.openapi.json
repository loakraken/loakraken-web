{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken history",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/history": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "캐릭터 관측 이력(그래프용)",
        "description": "검색할 때 저장한 아이템 레벨·전투력·원정대 레벨의 시계열입니다. 외부 API와 캐시를 사용하지 않습니다. 서버·캐릭터명이 함께 일치하는 기록만 반환하며 이름 변경·서버 이동은 자동 연결하지 않습니다. 기록이 없으면 빈 목록입니다.",
        "operationId": "observationHistory",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "검색 응답의 캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "검색 응답의 캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          },
          {
            "name": "serverName",
            "in": "query",
            "description": "검색 응답의 서버명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "검색 응답의 서버명",
              "example": "루페온",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "루페온"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "최근 관측 최대 개수",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100,
              "description": "최근 관측 최대 개수",
              "maximum": 500,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCharacterHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "캐릭터명·서버명 누락, 형식 오류 또는 limit 범위 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_HISTORY_DISABLED: 기능 비활성화 / CHARACTER_HISTORY_UNAVAILABLE: 저장소 장애",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseCharacterHistoryResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CharacterHistoryResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CharacterHistoryResponse": {
        "type": "object",
        "description": "그래프용 캐릭터 관측 이력. 최근 관측부터 limit개를 시간 오름차순으로 제공합니다.",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "serverName": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "description": "값이 바뀐 관측만 한 점이 됩니다. 같은 값의 재수집은 lastConfirmedAt만 갱신합니다.",
            "items": {
              "$ref": "#/components/schemas/PointResponse"
            }
          }
        },
        "required": [
          "characterName",
          "points",
          "serverName"
        ]
      },
      "PointResponse": {
        "type": "object",
        "properties": {
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "description": "이 값이 처음 관측된 UTC 시각"
          },
          "lastConfirmedAt": {
            "type": "string",
            "format": "date-time",
            "description": "같은 값이 마지막으로 확인된 UTC 시각"
          },
          "className": {
            "type": "string"
          },
          "characterLevel": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32"
              },
              {
                "type": "null"
              }
            ]
          },
          "itemLevel": {
            "type": "number"
          },
          "combatPower": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "expeditionLevel": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "characterLevel",
          "className",
          "combatPower",
          "expeditionLevel",
          "itemLevel",
          "lastConfirmedAt",
          "observedAt"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
