              {
                "type": "null"
              }
            ]
          },
          "timed": {
            "type": "boolean",
            "description": "true: 그 날 회차를 가리키는 시간 지정 보상, false: 시간 지정 없는 공통 보상"
          }
        },
        "required": [
          "grade",
          "icon",
          "name",
          "timed"
        ]
      },
      "HomeTimedResponse": {
        "type": "object",
