            "format": "date"
          },
          "islands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "date",
          "islands"
        ]
      },
      "HomeWeeklyDayResponse": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "islands": {
            "type": "array",
