          },
          "name": {
            "type": "string"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "minItemLevel": {
            "anyOf": [
              {
                "type": "integer",
