            "items": {
              "$ref": "#/components/schemas/HomeRewardGroupResponse"
            }
          },
          "nextAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "icon",
          "minItemLevel",
          "name",
          "nextAt",
          "rewardGroups",
          "startTimes"
        ]
      },
      "HomeOtherResponse": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
