{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken item-tooltips",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/item-tooltips": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "아이템 툴팁 나머지 줄(공식 호출 없음)",
        "description": "캐릭터 검색 응답에 넣지 않은 공식 Tooltip 나머지 줄(extraLines: 내구도·분해불가·설명·획득처 등)을 줍니다(#227). 공식 API를 부르지 않고 캐릭터 캐시만 읽습니다. 캐시가 없으면 404 CHARACTER_NOT_CACHED이며, 웹은 검색 응답의 짧은 필드만으로 툴팁을 그립니다. 항목은 검색 응답과 키로 잇습니다: equipment는 loadout.equipment 순번(index, 0부터)과 type, gems·cards는 slot, skills는 name. 줄이 없는 항목은 목록에서 뺍니다. 공개 제외 캐릭터는 hidden=true이고 목록이 비어 있습니다.",
        "operationId": "itemTooltips",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "원정대를 조회할 캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "원정대를 조회할 캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          }
        ],
        "responses": {
          "200": {
            "description": "CHARACTER_ITEM_TOOLTIPS_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCharacterItemTooltipsResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_CACHED: 캐릭터 캐시가 없음(공식 호출 없음)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_STORAGE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseCharacterItemTooltipsResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CharacterItemTooltipsResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CharacterItemTooltipsResponse": {
        "type": "object",
        "description": "아이템 툴팁 나머지 줄(#227). 공개 제외면 hidden=true이고 목록이 비어 있음",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean",
            "description": "공개 제외 캐릭터면 true"
          },
          "fetchedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "이 줄을 읽은 캐릭터 캐시의 수집 시각. 캐릭터 검색 응답 fetchedAt과 다르면 순번이 어긋났을 수 있으니 버리고 다시 부른다. 숨김이면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "equipment": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EquipmentLinesResponse"
            }
          },
          "gems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotLinesResponse"
            }
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotLinesResponse"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillLinesResponse"
            }
          }
        },
        "required": [
          "cards",
          "characterName",
          "equipment",
          "fetchedAt",
          "gems",
          "hidden",
          "skills"
        ]
      },
      "EquipmentLinesResponse": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32",
            "description": "검색 응답 loadout.equipment 배열 순번(0부터)",
            "example": 0
          },
          "type": {
            "type": "string",
            "description": "검색 응답 loadout.equipment[].type",
            "example": "무기"
          },
          "extraLines": {
            "type": "array",
            "description": "공식 Tooltip 나머지 줄(원문 순서)",
            "example": [
              "분해불가, 품질 업그레이드 불가",
              "[제작] 대도시",
              "내구도 62 / 175"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "extraLines",
          "index",
          "type"
        ]
      },
      "SlotLinesResponse": {
        "type": "object",
        "properties": {
          "slot": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "검색 응답 gems.items[].slot 또는 cards.items[].slot",
                "example": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "extraLines": {
            "type": "array",
            "description": "공식 Tooltip 나머지 줄(원문 순서)",
            "example": [
              "보석 레벨 6",
              "분해불가, 보석 합성 불가"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "extraLines",
          "slot"
        ]
      },
      "SkillLinesResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "검색 응답 skills[].name",
            "example": "블레이드 버스트"
          },
          "runeExtraLines": {
            "type": "array",
            "description": "룬 Tooltip 나머지 줄(설명·획득처)",
            "example": [
              "스킬에 강력한 힘을 부여할 수 있는 특별한 룬이다."
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "runeExtraLines"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
