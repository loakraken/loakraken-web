{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken item-tooltips",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/item-tooltips": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "아이템 툴팁 나머지 줄(공식 호출 없음)",
        "description": "캐릭터 검색 응답에 넣지 않은 공식 Tooltip 나머지 줄(extraLines: 내구도·분해불가·설명·획득처 등)을 줍니다(#227). 공식 API를 부르지 않고 캐릭터 캐시만 읽습니다. 캐시가 없으면 404 CHARACTER_NOT_CACHED이며, 웹은 검색 응답의 짧은 필드만으로 툴팁을 그립니다. 항목은 검색 응답과 키로 잇습니다: equipment는 loadout.equipment 순번(index, 0부터)과 type, gems·cards는 slot, skills는 name. 줄이 없는 항목은 목록에서 뺍니다. 공개 제외 캐릭터는 hidden=true이고 목록이 비어 있습니다.",
        "operationId": "itemTooltips",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "원정대를 조회할 캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "원정대를 조회할 캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          }
        ],
        "responses": {
          "200": {
            "description": "CHARACTER_ITEM_TOOLTIPS_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCharacterItemTooltipsResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_CACHED: 캐릭터 캐시가 없음(공식 호출 없음)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_STORAGE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseCharacterItemTooltipsResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CharacterItemTooltipsResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CharacterItemTooltipsResponse": {
        "type": "object",
        "description": "아이템 툴팁 나머지 줄(#227). 공개 제외면 hidden=true이고 목록이 비어 있음",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean",
            "description": "공개 제외 캐릭터면 true"
          },
          "fetchedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "이 줄을 읽은 캐릭터 캐시의 수집 시각. 캐릭터 검색 응답 fetchedAt과 다르면 순번이 어긋났을 수 있으니 버리고 다시 부른다. 숨김이면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "equipment": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EquipmentLinesResponse"
            }
          },
          "gems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotLinesResponse"
            }
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotLinesResponse"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillLinesResponse"
            }
          },
          "arkGrid": {
            "type": "array",
            "description": "아크 그리드 코어·젬 툴팁 줄(#288). 키는 검색 응답 arkGrid.slots[].index와 그 gems[].index",
            "items": {
              "$ref": "#/components/schemas/GridLinesResponse"
            }
          }
        },
        "required": [
          "arkGrid",
          "cards",
          "characterName",
          "equipment",
          "fetchedAt",
          "gems",
          "hidden",
          "skills"
        ]
      },
      "EquipmentLinesResponse": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32",
            "description": "검색 응답 loadout.equipment 배열 순번(0부터)",
            "example": 0
          },
          "type": {
            "type": "string",
            "description": "검색 응답 loadout.equipment[].type",
            "example": "무기"
          },
          "extraLines": {
            "type": "array",
            "description": "공식 Tooltip 나머지 줄(원문 순서)",
            "example": [
              "분해불가, 품질 업그레이드 불가",
              "[제작] 대도시",
              "내구도 62 / 175"
            ],
            "items": {
              "type": "string"
            }
          },
          "extraLineSections": {
            "type": "array",
            "description": "extraLines와 같은 길이로, 각 줄 바로 앞에 나온 공식 Tooltip 섹션 제목(예: '팔찌 효과', '아크 패시브 포인트 효과'). 앞에 섹션이 없으면 빈 문자열. 캐시가 이전 형식이면 빈 목록이라 웹은 지금처럼 끝에 둔다(#285)",
            "example": [
              "",
              "팔찌 효과",
              "팔찌 효과"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "extraLineSections",
          "extraLines",
          "index",
          "type"
        ]
      },
      "SlotLinesResponse": {
        "type": "object",
        "properties": {
          "slot": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "검색 응답 gems.items[].slot 또는 cards.items[].slot",
                "example": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "extraLines": {
            "type": "array",
            "description": "공식 Tooltip 나머지 줄(원문 순서)",
            "example": [
              "보석 레벨 6",
              "분해불가, 보석 합성 불가"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "extraLines",
          "slot"
        ]
      },
      "SkillLinesResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "검색 응답 skills[].name",
            "example": "블레이드 버스트"
          },
          "runeExtraLines": {
            "type": "array",
            "description": "룬 Tooltip 나머지 줄(설명·획득처)",
            "example": [
              "스킬에 강력한 힘을 부여할 수 있는 특별한 룬이다."
            ],
            "items": {
              "type": "string"
            }
          },
          "titleLines": {
            "type": "array",
            "description": "공식 Tooltip 제목 줄(아이콘 옆, 원문 순서: 스킬 종류·재사용 대기시간·분류). 이전 캐시면 빈 목록",
            "example": [
              "일반",
              "재사용 대기시간 5초",
              "[일반 스킬]"
            ],
            "items": {
              "type": "string"
            }
          },
          "infoLines": {
            "type": "array",
            "description": "공식 Tooltip 현재 레벨 정보 줄(원문 순서: PvE·스킬 레벨·마나 소모·부위 파괴·무력화·공격 타입·슈퍼아머 등). 다음 레벨 정보·트라이포드·룬·보석 효과는 빼고, 이전 캐시면 빈 목록",
            "example": [
              "PvE",
              "스킬 레벨 10",
              "마나 349 소모",
              "공격 타입 : 백 어택",
              "슈퍼아머 : 경직 면역"
            ],
            "items": {
              "type": "string"
            }
          },
          "tripodOptions": {
            "type": "array",
            "description": "공식 트라이포드 전체 선택지(선택 여부 포함, 공식 순서). 효과 문장은 검색 응답 skills[].tripods(선택된 것)에만 있음. 이전 캐시면 빈 목록",
            "items": {
              "$ref": "#/components/schemas/TripodOptionResponse"
            }
          }
        },
        "required": [
          "infoLines",
          "name",
          "runeExtraLines",
          "titleLines",
          "tripodOptions"
        ]
      },
      "TripodOptionResponse": {
        "type": "object",
        "properties": {
          "tier": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "공식 Tier(0부터)",
                "example": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "slot": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "공식 Slot(1부터)",
                "example": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "example": "약점 노출"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "selected": {
            "type": "boolean",
            "description": "선택한 트라이포드면 true"
          }
        },
        "required": [
          "icon",
          "name",
          "selected",
          "slot",
          "tier"
        ]
      },
      "GridLinesResponse": {
        "type": "object",
        "properties": {
          "index": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "검색 응답 arkGrid.slots[].index",
                "example": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "titleLine": {
            "anyOf": [
              {
                "type": "string",
                "description": "공식 Tooltip 등급 줄",
                "example": "유물 아크 그리드 코어"
              },
              {
                "type": "null"
              }
            ]
          },
          "tradeLines": {
            "type": "array",
            "description": "공식 Tooltip 귀속·거래 줄(제목 바로 뒤)",
            "items": {
              "type": "string"
            }
          },
          "extraLines": {
            "type": "array",
            "description": "공식 Tooltip 나머지 줄(원문 순서)",
            "example": [
              "거래 불가",
              "분해불가"
            ],
            "items": {
              "type": "string"
            }
          },
          "gems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GridGemLinesResponse"
            }
          }
        },
        "required": [
          "extraLines",
          "gems",
          "index",
          "titleLine",
          "tradeLines"
        ]
      },
      "GridGemLinesResponse": {
        "type": "object",
        "properties": {
          "index": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
                "description": "검색 응답 arkGrid.slots[].gems[].index",
                "example": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "titleLine": {
            "anyOf": [
              {
                "type": "string",
                "description": "공식 Tooltip 등급 줄",
                "example": "전설 아크 그리드 젬"
              },
              {
                "type": "null"
              }
            ]
          },
          "tradeLines": {
            "type": "array",
            "description": "공식 Tooltip 귀속·거래 줄",
            "example": [
              "가공 완료",
              "거래 불가"
            ],
            "items": {
              "type": "string"
            }
          },
          "extraLines": {
            "type": "array",
            "description": "공식 Tooltip 나머지 줄(원문 순서)",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "extraLines",
          "index",
          "titleLine",
          "tradeLines"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
