{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken popular-guilds",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/guilds/popular": {
      "get": {
        "tags": [
          "통계·랭킹"
        ],
        "summary": "인기 길드",
        "description": "LOAKraken 캐릭터 검색으로 집계한 인기 길드입니다(popular-guild-v1). 순위 기준: 집계 시점에 그 길드로 관측된 캐릭터들의 고유 조회 합(인기 캐릭터와 같은 기준 — 같은 클라이언트·같은 캐릭터를 KST 하루 1회만 셈, 24h는 최근 24개 시간 버킷, 7d는 168개)이며, 합이 인기 캐릭터와 같은 최소 기준 이상인 길드만 올립니다. 조회 수 숫자는 공개하지 않습니다. 같은 합은 길드 이름순으로 1, 2, 3 차례입니다. 기간 전체 고유 조회가 30회 미만이면 sampleStatus=COLLECTING이고 목록이 비어 있습니다. 처리정지 목록에 있는 캐릭터의 조회는 합에 넣지 않습니다(길드는 남음). 10분 캐시이며 공식 API를 부르지 않습니다.",
        "operationId": "popular",
        "parameters": [
          {
            "name": "server",
            "in": "query",
            "description": "서버 이름. 없으면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "period",
            "in": "query",
            "description": "24h(최근 24시간, 기본) 또는 7d(최근 7일)",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "24h|7d"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "개수(기본 10, 최대 50)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GUILD_POPULAR_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseGuildPopularResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: server·period·limit 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_POPULAR_DISABLED 또는 CHARACTER_POPULAR_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseGuildPopularResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/GuildPopularResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "GuildPopularResponse": {
        "type": "object",
        "description": "인기 길드(popular-guild-v1). 순위 기준은 길드원 캐릭터들의 고유 조회 합이며, 숫자는 공개하지 않습니다.",
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "24h",
              "7d"
            ]
          },
          "aggregatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sampleStatus": {
            "type": "string",
            "description": "COLLECTING이면 items가 비어 있습니다",
            "enum": [
              "COLLECTING",
              "READY"
            ]
          },
          "ruleVersion": {
            "type": "string",
            "example": "popular-guild-v1"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuildPopularItemResponse"
            }
          }
        },
        "required": [
          "aggregatedAt",
          "items",
          "period",
          "ruleVersion",
          "sampleStatus"
        ]
      },
      "GuildPopularItemResponse": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "format": "int32",
            "description": "1부터 차례(같은 합은 길드 이름순)"
          },
          "serverName": {
            "type": "string"
          },
          "guildName": {
            "type": "string",
            "description": "공식 프로필 길드 이름"
          }
        },
        "required": [
          "guildName",
          "rank",
          "serverName"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
