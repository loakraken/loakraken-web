{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken public-summary",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/public-summary": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "캐릭터 공개 요약(공식 호출 없음)",
        "description": "캐릭터 페이지 첫 HTML(제목·설명·요약 줄·구조화 데이터)용 가벼운 요약입니다. 봇·사람 구분 없이 같은 값을 줍니다. 공식 API를 부르지 않고 캐릭터 캐시 → 저장된 마지막 관측 순서로 찾습니다. 둘 다 없으면 404 CHARACTER_NOT_CACHED입니다. ",
        "operationId": "publicSummary",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "원정대를 조회할 캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "원정대를 조회할 캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          }
        ],
        "responses": {
          "200": {
            "description": "CHARACTER_PUBLIC_SUMMARY_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCharacterPublicSummaryResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_CACHED: 캐시에도 저장된 관측에도 없음(공식 호출 없음)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_STORAGE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseCharacterPublicSummaryResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CharacterPublicSummaryResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CharacterPublicSummaryResponse": {
        "type": "object",
        "description": "캐릭터 공개 요약",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "serverName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "className": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "characterLevel": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32"
              },
              {
                "type": "null"
              }
            ]
          },
          "itemLevel": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "combatPower": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "arkPassiveTitle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "이 값을 확인한 시각. STORED_OBSERVATION이면 화면에 '마지막 확인 시각'으로 보인다"
              },
              {
                "type": "null"
              }
            ]
          },
          "dataSource": {
            "anyOf": [
              {
                "type": "string",
                "description": "LIVE_CACHE: 최근 5분 안 공식 조회 캐시, STORED_OBSERVATION: 저장된 마지막 관측.",
                "enum": [
                  "LIVE_CACHE",
                  "STORED_OBSERVATION"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "indexable": {
            "type": "boolean",
            "description": "false면 웹은 noindex·sitemap 제외"
          }
        },
        "required": [
          "arkPassiveTitle",
          "characterLevel",
          "characterName",
          "className",
          "combatPower",
          "dataSource",
          "indexable",
          "itemLevel",
          "observedAt",
          "serverName"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
