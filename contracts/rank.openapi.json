              {
                "type": "null"
              }
            ]
          },
          "itemLevel": {
            "type": "number"
          },
          "combatPower": {
            "type": "number"
          },
          "refreshedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "rankVisibility": {
            "type": "string",
            "description": "순위 공개 여부. 이 값이 최우선이다. HIDDEN(운영 공개 제외 목록)이면 entries는 빈 배열이고 순위·백분위·티어는 어디에도 없다. 이때 다른 메타(included 등)로 순위 상태를 판단하지 않는다. VISIBLE이면 included와 entries의 sampleStatus로 판단한다",
            "enum": [
              "VISIBLE",
              "HIDDEN"
            ]
          },
          "included": {
            "type": "boolean",
            "description": "조건(최근 확인 기간·레벨 범위 등)의 모집단에 들어가는가. false면 entries는 빈 배열. HIDDEN이면 항상 false"
          },
          "conditions": {
            "$ref": "#/components/schemas/StatsConditionsResponse"
          },
          "aggregatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ruleVersion": {
            "type": "string"
          },
          "minSample": {
            "type": "integer",
            "format": "int32"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatsRankEntryResponse"
            }
          }
        },
        "required": [
          "aggregatedAt",
          "characterName",
          "className",
          "combatPower",
          "conditions",
          "entries",
          "included",
          "itemLevel",
          "minSample",
          "position",
          "rankVisibility",
          "refreshedAt",
          "ruleVersion",
          "serverName"
        ]
      },
