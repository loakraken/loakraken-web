{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken rank",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/rank": {
      "get": {
        "tags": [
          "통계·랭킹"
        ],
        "summary": "캐릭터 순위",
        "description": "전투력·아이템 레벨 각각의 전체·서버·직업 순위와 상위 %, 티어(TOP1|TOP5|TOP10|TOP25|TOP50|REST). LOAKraken에 기록된 값 기준이라 캐릭터를 먼저 검색하면 최신 값으로 계산됩니다. 404 STATS_CHARACTER_NOT_OBSERVED, 400 INVALID_REQUEST·STATS_INVALID_RANGE·STATS_TOO_MANY_BINS, 503 STATS_UNAVAILABLE",
        "operationId": "characterRank",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "server",
            "in": "query",
            "description": "서버명. 생략하면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "description": "서버명. 생략하면 전체",
              "maxLength": 32,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "role",
            "in": "query",
            "description": "DEALER 또는 SUPPORT. 생략하면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "description": "DEALER 또는 SUPPORT. 생략하면 전체",
              "enum": [
                "DEALER",
                "SUPPORT"
              ]
            }
          },
          {
            "name": "className",
            "in": "query",
            "description": "직업명. 생략하면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "description": "직업명. 생략하면 전체",
              "maxLength": 32,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "activeDays",
            "in": "query",
            "description": "최근 확인 기간(일): 7, 30, 90",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 30,
              "description": "최근 확인 기간(일): 7, 30, 90"
            }
          },
          {
            "name": "itemLevelMin",
            "in": "query",
            "description": "최소 아이템 레벨",
            "required": false,
            "schema": {
              "type": "number",
              "default": 1640,
              "description": "최소 아이템 레벨",
              "maximum": 2000,
              "minimum": 0
            }
          },
          {
            "name": "itemLevelMax",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 2000,
              "minimum": 0
            }
          },
          {
            "name": "combatPowerMin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100000,
              "minimum": 0
            }
          },
          {
            "name": "combatPowerMax",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100000,
              "minimum": 0
            }
          },
          {
            "name": "representativeOnly",
            "in": "query",
            "description": "원정대(같은 서버) 대표 캐릭터(아이템 레벨 최고)만",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "description": "원정대(같은 서버) 대표 캐릭터(아이템 레벨 최고)만"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseStatsCharacterRankResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, STATS_INVALID_RANGE 또는 STATS_TOO_MANY_BINS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "STATS_CHARACTER_NOT_OBSERVED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STATS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseStatsCharacterRankResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/StatsCharacterRankResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "StatsCharacterRankResponse": {
        "type": "object",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "serverName": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "DEALER",
                  "SUPPORT"
