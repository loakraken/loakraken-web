{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken rankings",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/rankings": {
      "get": {
        "tags": [
          "통계·랭킹"
        ],
        "summary": "랭킹",
        "description": "전투력 또는 아이템 레벨 순위. 서버·직업·역할 등 필터로 범위를 정합니다. 동률은 같은 순위입니다. 50개 단위 페이지, 최대 10,000위까지. 400 INVALID_REQUEST·STATS_INVALID_RANGE·STATS_TOO_MANY_BINS, 503 STATS_UNAVAILABLE",
        "operationId": "rankings",
        "parameters": [
          {
            "name": "server",
            "in": "query",
            "description": "서버명. 생략하면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "description": "서버명. 생략하면 전체",
              "maxLength": 32,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "role",
            "in": "query",
            "description": "DEALER 또는 SUPPORT. 생략하면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "description": "DEALER 또는 SUPPORT. 생략하면 전체",
              "enum": [
                "DEALER",
                "SUPPORT"
              ]
            }
          },
          {
            "name": "className",
            "in": "query",
            "description": "직업명. 생략하면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "description": "직업명. 생략하면 전체",
              "maxLength": 32,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "activeDays",
            "in": "query",
            "description": "최근 확인 기간(일): 7, 30, 90",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 30,
              "description": "최근 확인 기간(일): 7, 30, 90"
            }
          },
          {
            "name": "itemLevelMin",
            "in": "query",
            "description": "최소 아이템 레벨",
            "required": false,
            "schema": {
              "type": "number",
              "default": 1640,
              "description": "최소 아이템 레벨",
              "maximum": 2000,
              "minimum": 0
            }
          },
          {
            "name": "itemLevelMax",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 2000,
              "minimum": 0
            }
          },
          {
            "name": "combatPowerMin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100000,
              "minimum": 0
            }
          },
          {
            "name": "combatPowerMax",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100000,
              "minimum": 0
            }
          },
          {
            "name": "representativeOnly",
            "in": "query",
            "description": "원정대(같은 서버) 대표 캐릭터(아이템 레벨 최고)만",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "description": "원정대(같은 서버) 대표 캐릭터(아이템 레벨 최고)만"
            }
          },
          {
            "name": "metric",
            "in": "query",
            "description": "COMBAT_POWER(기본) 또는 ITEM_LEVEL",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "COMBAT_POWER",
                "ITEM_LEVEL"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "1부터",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 201,
              "minimum": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "페이지 크기(기본 50, 최대 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseStatsRankingResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, STATS_INVALID_RANGE 또는 STATS_TOO_MANY_BINS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STATS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rankings/bracelets": {
