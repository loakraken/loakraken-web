  "components": {
    "schemas": {
      "ApiResponseStatsRankingResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/StatsRankingResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "StatsRankingResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/StatsMetaResponse"
          },
          "metric": {
            "type": "string",
            "enum": [
              "COMBAT_POWER",
              "ITEM_LEVEL"
            ]
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "rows": {
            "type": "array",
            "description": "전체 순위 대상 수는 meta.population",
            "items": {
              "$ref": "#/components/schemas/StatsRankedCharacterResponse"
            }
          }
        },
        "required": [
          "meta",
          "metric",
          "page",
          "rows",
          "size"
        ]
      },
      "StatsMetaResponse": {
        "type": "object",
        "description": "공통 메타. 모집단은 LOAKraken이 관측한 캐릭터 중 최근 activeDays일 안에 프로필(전투력)을 확인한 캐릭터이며 게임 전체 인구가 아닙니다.",
        "properties": {
          "population": {
            "type": "integer",
            "format": "int64",
            "description": "조건에 맞는 캐릭터 수"
          },
          "conditions": {
            "$ref": "#/components/schemas/StatsConditionsResponse"
          },
          "aggregatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "snapshot": {
            "type": "string",
            "description": "현재는 latest만 제공합니다",
            "example": "latest"
          },
          "ruleVersion": {
            "type": "string",
            "example": "stats-v1"
          },
          "minSample": {
            "type": "integer",
            "format": "int32",
            "example": 30
          },
          "sampleStatus": {
            "type": "string",
            "description": "COLLECTING(표본 30명 미만) 또는 READY",
            "enum": [
              "COLLECTING",
              "READY"
            ]
          },
          "coverage": {
            "$ref": "#/components/schemas/StatsCoverageResponse"
          },
          "populationUnit": {
            "type": "string",
            "description": "population을 세는 단위: CHARACTER(캐릭터), ROSTER(원정대), GUILD(길드). 문자열이며 값이 늘 수 있음",
            "example": "CHARACTER"
          }
        },
        "required": [
          "aggregatedAt",
          "conditions",
          "coverage",
          "minSample",
          "population",
          "populationUnit",
          "ruleVersion",
          "sampleStatus",
          "snapshot"
        ]
      },
      "StatsConditionsResponse": {
        "type": "object",
        "description": "정규화한 조건(기본값 포함)",
        "properties": {
          "server": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "anyOf": [
                              {
                                "anyOf": [
                                  {
                                    "anyOf": [
                                      {
                                        "anyOf": [
                                          {
                                            "anyOf": [
                                              {
                                                "anyOf": [
                                                  {
                                                    "type": "string"
                                                  },
                                                  {
                                                    "type": "null"
                                                  }
                                                ]
                                              },
                                              {
                                                "type": "null"
                                              }
                                            ]
                                          },
                                          {
                                            "type": "null"
                                          }
                                        ]
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
