{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken receipt",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/receipt": {
      "get": {
        "tags": [
          "원정대 영수증"
        ],
        "summary": "원정대 영수증",
        "description": "같은 서버 원정대의 장비 재련 기대 비용(+10→현재, 단계별 숨결·책 최소, 업화 18 이하 성장 지원, 현재 최저가)과 거래 가능 보석 시세를 더합니다. 젬·팔찌·악세는 금액에 넣지 않고 개수만 줍니다. 전투정보는 캐시를 먼저 쓰고, 한 요청에 최대 8명만 공식 API로 새로 받습니다(나머지 PENDING, 다시 요청하면 이어서). 계산 일치 원칙 검증(재련 성공률 근거·완갑 포함) 전까지 기본으로 꺼져 있습니다(receipt.enabled).",
        "operationId": "receipt",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "원정대 캐릭터 이름",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "assumeBook",
            "in": "query",
            "description": "책(재봉술·야금술) 효과 적용 가정. 생략하면 true(책 포함). false면 책을 빼고 숨결만 쓴 값이다(게임 문구 '특수 재료 별 효과는 확률에 따라 적용되지 않을 수 있습니다'의 확률은 공개되지 않음)",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "RECEIPT_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseReceiptResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "LOST_ARK_RATE_LIMITED / CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_CACHE_UNAVAILABLE·MARKET_CACHE_UNAVAILABLE·LOST_ARK_GATE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseReceiptResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/ReceiptResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "ReceiptResponse": {
        "type": "object",
        "description": "원정대 영수증(receipt-v1). 검증된 항목(장비 재련·거래 가능 보석)만 금액에 넣는다",
        "properties": {
          "ruleVersion": {
            "type": "string"
          },
          "refiningRuleVersion": {
            "type": "string",
            "description": "장비 재련 계산 규칙 버전"
          },
          "serverName": {
            "type": "string"
          },
          "characterName": {
            "type": "string"
          },
          "computedAt": {
            "type": "string",
            "format": "date-time",
            "description": "이 영수증을 계산한 시각"
          },
          "priceObservedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "재료·보석 시세 중 가장 이른 관측 시각. 시세를 쓰지 않았으면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "$ref": "#/components/schemas/ReceiptTotalResponse"
          },
          "equipment": {
            "$ref": "#/components/schemas/ReceiptEquipmentResponse"
          },
          "gems": {
            "$ref": "#/components/schemas/ReceiptGemsResponse"
          },
          "notIncluded": {
            "type": "array",
            "description": "금액에 넣지 않은 분류(산정 기준 검증 중)",
            "items": {
              "$ref": "#/components/schemas/ReceiptNotIncludedResponse"
            }
          },
          "coverage": {
            "$ref": "#/components/schemas/ReceiptCoverageResponse"
          },
          "assumptions": {
            "type": "array",
            "description": "화면에 그대로 보이는 가정 문장",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "assumptions",
          "characterName",
          "computedAt",
          "coverage",
          "equipment",
          "gems",
          "notIncluded",
          "priceObservedAt",
          "refiningRuleVersion",
          "ruleVersion",
          "serverName",
          "total"
        ]
      },
      "ReceiptTotalResponse": {
        "type": "object",
        "properties": {
          "gold": {
            "type": "number",
            "description": "포함 분류 합계(골드)"
          },
          "includedKinds": {
            "type": "array",
            "description": "금액에 넣은 분류",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "gold",
          "includedKinds"
        ]
      },
      "ReceiptEquipmentResponse": {
        "type": "object",
        "properties": {
          "gold": {
            "type": "number"
          },
          "characters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiptCharacterResponse"
            }
          }
        },
        "required": [
          "characters",
          "gold"
        ]
      },
      "ReceiptCharacterResponse": {
        "type": "object",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "className": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "itemLevel": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "description": "READY 또는 PENDING(이번 요청에서 전투정보를 아직 받지 못함)",
            "enum": [
              "READY",
              "PENDING"
            ]
          },
          "gold": {
            "anyOf": [
              {
                "type": "number",
                "description": "PENDING이면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiptPartResponse"
            }
          },
          "excluded": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiptExcludedResponse"
            }
          }
        },
        "required": [
          "characterName",
          "className",
          "excluded",
          "gold",
          "itemLevel",
          "parts",
          "status"
        ]
      },
      "ReceiptPartResponse": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "enum": [
              "UPHWA",
              "JEONYUL"
            ]
          },
          "fromStage": {
            "type": "integer",
            "format": "int32",
            "description": "산정 시작 단계(10)"
          },
          "toStage": {
            "type": "integer",
            "format": "int32",
            "description": "현재 단계. 10 이하면 비용 0"
          },
          "gold": {
            "type": "number"
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiptStageResponse"
            }
          }
        },
        "required": [
          "fromStage",
          "gold",
          "grade",
          "name",
          "slot",
          "stages",
          "toStage"
        ]
      },
      "ReceiptStageResponse": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "integer",
            "format": "int32",
            "description": "목표 단계"
          },
          "gold": {
            "type": "number",
            "description": "그 단계 기대 비용(골드)"
          },
          "breath": {
            "type": "boolean",
            "description": "회차별 최적 전략에서 숨결을 쓰는 회차가 있음"
          },
          "book": {
            "type": "boolean",
            "description": "회차별 최적 전략에서 책을 쓰는 회차가 있음"
          },
          "growthSupport": {
            "type": "boolean",
            "description": "성장 지원 적용(업화 18단계 이하)"
          }
        },
        "required": [
          "book",
          "breath",
          "gold",
          "growthSupport",
          "stage"
        ]
      },
      "ReceiptExcludedResponse": {
        "type": "object",
        "properties": {
          "slot": {
            "anyOf": [
              {
                "type": "string",
                "description": "부위. 상급 재련처럼 캐릭터 전체에 걸린 사유면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "description": "UNSUPPORTED_GRADE·UNSUPPORTED_STAGE·ARM_GUARD·ADVANCED_REFINING·PRICE_UNAVAILABLE",
            "enum": [
              "UNSUPPORTED_GRADE",
              "UNSUPPORTED_STAGE",
              "ARM_GUARD",
              "ADVANCED_REFINING",
              "PRICE_UNAVAILABLE",
              "GROWTH_COST_UNCONFIRMED",
              "LIMIT_BREAK_UNPRICED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "name",
          "reason",
          "slot"
        ]
      },
      "ReceiptGemsResponse": {
        "type": "object",
        "properties": {
          "gold": {
            "type": "number",
            "description": "시세가 있는 거래 가능 보석 합계"
          },
          "tradable": {
            "type": "integer",
            "format": "int32",
            "description": "거래 가능 보석 수"
          },
          "priced": {
            "type": "integer",
            "format": "int32",
            "description": "그중 시세로 환산한 수"
          },
          "bound": {
            "type": "integer",
            "format": "int32",
            "description": "귀속 보석 수(금액 제외)"
          },
          "unpriced": {
            "type": "integer",
            "format": "int32",
            "description": "시세 없음·대기로 환산하지 못한 수"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiptGemResponse"
            }
          }
        },
        "required": [
          "bound",
          "gold",
          "items",
          "priced",
          "tradable",
          "unpriced"
        ]
      },
      "ReceiptGemResponse": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "format": "int32"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "unitPrice": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "gold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "description": "PRICED·NO_PRICE(시세 표에 없는 종류)·PENDING(칸이 아직 빔)",
            "enum": [
              "PRICED",
              "NO_PRICE",
              "PENDING"
            ]
          }
        },
        "required": [
          "count",
          "gold",
          "kind",
          "level",
          "status",
          "unitPrice"
        ]
      },
      "ReceiptNotIncludedResponse": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "ARK_GRID_GEM·BRACELET·ACCESSORY"
          },
          "reason": {
            "type": "string",
            "description": "VERIFYING(산정 기준 검증 중)"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "count",
          "kind",
          "reason"
        ]
      },
      "ReceiptCoverageResponse": {
        "type": "object",
        "properties": {
          "rosterCharacters": {
            "type": "integer",
            "format": "int32"
          },
          "ready": {
            "type": "integer",
            "format": "int32"
          },
          "pending": {
            "type": "integer",
            "format": "int32",
            "description": "아직 전투정보를 받지 못한 캐릭터 수(다시 요청하면 최대 8명씩 채움)"
          },
          "nextAvailableAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "남은 캐릭터를 이어 받을 수 있는 시각. 상한으로 멈췄으면 지금, 공식 한도·장애로 멈췄으면 1분 뒤. 남은 사람이 없으면 null"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "nextAvailableAt",
          "pending",
          "ready",
          "rosterCharacters"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
