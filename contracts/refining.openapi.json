{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken refining",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/refining/plans": {
      "post": {
        "tags": [
          "재련"
        ],
        "summary": "티어 4 재련 기대 비용",
        "description": "운명의 업화·운명의 전율 무기/방어구의 현재 단계부터 목표 단계(11~25)까지 기대·중앙값·90%·최대 시도 수와 재료·골드를 계산합니다. 외부 API·DB를 사용하지 않습니다. 단계별 수치는 MIT 라이선스 공개 데이터(고지는 저장소 NOTICE)를 전수 교차 검증한 값이며 공식 표가 아닙니다.",
        "operationId": "plan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefiningPlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "REFINING_PLAN_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseRefiningPlanResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: 단계 범위·장인의 기운·실패 횟수 오류, useBreath와 breath가 어긋남, OPTIMAL 스위치가 꺼져 있는데 breath=OPTIMAL. REFINING_SUCCESS_RATE_MISMATCH: currentSuccessRate가 첫 단계 기본 확률 × (1 + 0.1 × 실패 0~10) 어느 값과도 같지 않음(숨결·책을 더한 값 등). REFINING_ARTISAN_ENERGY_MISMATCH: 성공 확률로 정한 실패 횟수와 currentArtisanEnergy가 맞지 않음(그 횟수만큼 실패해 쌓일 수 있는 기운 밖)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "406": {
            "description": "NOT_ACCEPTABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "REFINING_PRICE_PENDING: breath=OPTIMAL인데 필요한 재료 시세가 아직 없음(Retry-After 초). 다른 방식으로 대신 계산하지 않는다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_MEDIA_TYPE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "REFINING_SOLVE_BUSY: breath=OPTIMAL인데 서버의 최적 풀이 자리가 모두 차 있음(기다리지 않음, Retry-After 초 뒤 다시) / CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_SERVER_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RefiningPlanRequest": {
        "type": "object",
        "properties": {
          "grade": {
            "type": "string",
            "description": "UPHWA: 운명의 업화, JEONYUL: 운명의 전율. WEAPON·ARMOR는 필수, ARM_GUARD(완갑)는 단계표가 하나라 보지 않는다(생략 가능)",
            "enum": [
              "UPHWA",
              "JEONYUL"
            ],
            "example": "UPHWA"
          },
          "equipmentType": {
            "type": "string",
            "description": "WEAPON: 무기, ARMOR: 방어구, ARM_GUARD: 팔 보호구(완갑)",
            "enum": [
              "WEAPON",
              "ARMOR",
              "ARM_GUARD"
            ],
            "example": "ARMOR"
          },
          "fromStage": {
            "type": "integer",
            "format": "int32",
            "description": "현재 재련 단계. WEAPON·ARMOR 10~24, ARM_GUARD 0~24",
            "example": 18,
            "maximum": 24,
            "minimum": 0
          },
          "toStage": {
            "type": "integer",
            "format": "int32",
            "description": "목표 재련 단계. WEAPON·ARMOR 11~25, ARM_GUARD 1~25",
            "example": 20,
            "maximum": 25,
            "minimum": 1
          },
          "useBreath": {
            "type": "boolean",
            "default": false,
            "description": "매 시도 숨결을 최대 개수로 사용. breath를 보내면 breath가 정한다(서로 어긋나면 400)"
          },
          "useBook": {
            "type": "boolean",
            "default": true,
            "description": "책(재봉술·야금술)을 사용할 수 있는 단계에서 사용. 업화 11~20단계·전율 12~19단계(책 증가 = 그 단계 기본 성공률). 생략하면 true(책 포함, 2026-10-11 결정)"
          },
          "growthSupport": {
            "type": "boolean",
            "default": true,
            "description": "업화 목표 18단계 이하 재련 골드 20% 감소(공식 성장 지원). 상시 효과라 생략하면 켬"
          },
          "currentArtisanEnergy": {
            "type": "number",
            "default": 0,
            "description": "첫 단계의 현재 장인의 기운(%). 게임 화면처럼 소수 셋째 자리까지 받되 0.01%p 단위여야 함(46.500 = 46.50)",
            "example": 46.5,
            "maximum": 100,
            "minimum": 0
          },
          "currentFailedAttempts": {
            "type": "integer",
            "format": "int32",
            "default": 0,
            "description": "첫 단계에서 이미 실패한 횟수",
            "maximum": 10,
            "minimum": 0
          },
          "growthCost": {
            "type": "boolean",
            "default": false,
            "description": "장비 성장(경험치) 비용(단계당 1회 운명의 파편)을 더함. 웹이 토글·표시를 넣고 true를 보낼 때까지 공개 합계가 바뀌지 않게 생략하면 끔"
          },
          "expResearch": {
            "type": "boolean",
            "default": true,
            "description": "원정대 영지 연구 '티어 4 Lv.1590 장비 11~14단계 재련 필요 경험치 20% 감소' 적용(업화 목표 11~14단계 성장 파편 × 0.8). growthCost=true일 때만 의미가 있다. 생략하면 켬"
          },
          "breath": {
            "type": "string",
            "description": "숨결 사용 방식. NONE: 쓰지 않음, MAX: 매 시도 최대 개수, OPTIMAL: 시도마다 숨결 개수(와 useBook이면 책)를 골라 지금 시세 기준 기대 비용이 가장 작은 방법(재료 시세가 필요 — 없으면 409 REFINING_PRICE_PENDING. 서버 스위치가 꺼져 있으면 400 INVALID_REQUEST). 생략하면 useBreath(true면 MAX, 아니면 NONE)",
            "enum": [
              "NONE",
              "MAX",
              "OPTIMAL"
            ],
            "example": "OPTIMAL"
          },
          "currentSuccessRate": {
            "type": "number",
            "description": "첫 단계의 현재 성공 확률(%, 게임 재련 화면 값을 숨결·책을 올리기 전에 읽은 것, 화면처럼 소수 셋째 자리까지 받음: 3.300 = 3.30). currentFailedAttempts가 없을 때 이 값으로 실패 횟수를 정한다(기본 확률 × (1 + 0.1 × 실패 0~10)과 같아야 함, 아니면 400 REFINING_SUCCESS_RATE_MISMATCH). 장인의 기운은 그 실패 횟수로 쌓일 수 있는 값이어야 함(아니면 400 REFINING_ARTISAN_ENERGY_MISMATCH). 둘 다 없으면 실패 0",
            "example": 3.3,
            "maximum": 100,
            "minimum": 0
          }
        },
        "required": [
          "equipmentType",
          "fromStage",
          "toStage"
        ]
      },
      "ApiResponseRefiningPlanResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/RefiningPlanResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "RefiningPlanResponse": {
        "type": "object",
        "description": "재련 기대 비용. 기대값은 확률 분포의 평균이며, 최악은 장인의 기운으로 확정될 때까지 모두 실패한 경우입니다. 시세 환산·실링은 포함하지 않습니다.",
        "properties": {
          "ruleVersion": {
            "type": "string",
            "description": "단계표 규칙 버전(ARM_GUARD는 팔 보호구 단계표 버전)"
          },
          "source": {
            "$ref": "#/components/schemas/SourceResponse"
          },
          "grade": {
            "anyOf": [
              {
                "type": "string",
                "description": "요청 등급. ARM_GUARD(완갑)는 단계표가 하나라 null",
                "enum": [
                  "UPHWA",
                  "JEONYUL"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "equipmentType": {
            "type": "string",
            "enum": [
              "WEAPON",
              "ARMOR",
              "ARM_GUARD"
            ]
          },
          "fromStage": {
            "type": "integer",
            "format": "int32"
          },
          "toStage": {
            "type": "integer",
            "format": "int32"
          },
          "useBreath": {
            "type": "boolean"
          },
          "useBook": {
            "type": "boolean"
          },
          "growthSupport": {
            "type": "boolean"
          },
          "growthCost": {
            "type": "boolean",
            "description": "장비 성장(경험치) 비용을 더했는지"
          },
          "expResearch": {
            "type": "boolean",
            "description": "영지 연구(업화 목표 11~14단계 성장 경험치 20% 감소)를 적용했는지"
          },
          "growthSource": {
            "$ref": "#/components/schemas/GrowthSourceResponse",
            "description": "성장 비용 출처"
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StageResponse"
            }
          },
          "expectedMaterials": {
            "type": "array",
            "description": "단계별 기대 소모량(소수 둘째 자리 반올림)의 합",
            "items": {
              "$ref": "#/components/schemas/QuantityResponse"
            }
          },
          "worstCaseMaterials": {
            "type": "array",
            "description": "모든 단계가 최대 시도 수까지 간 경우의 소모량",
            "items": {
              "$ref": "#/components/schemas/QuantityResponse"
            }
          },
          "expectedGold": {
            "type": "number"
          },
          "worstCaseGold": {
            "type": "integer",
            "format": "int64"
          },
          "nonGold": {
            "type": "array",
            "description": "골드로 바꾸지 않고 재료 합계에도 넣지 않은 성장 비용의 합(실링, 전율 방어구 21단계 한계 해방의 고통의 가시). 단계마다 한 번 들어 기대·최악이 같다. growthCost=false거나 없으면 빈 목록",
            "items": {
              "$ref": "#/components/schemas/QuantityResponse"
            }
          },
          "assumptions": {
            "type": "array",
            "description": "계산 가정과 제외 항목",
            "items": {
              "type": "string"
            }
          },
          "breath": {
            "type": "string",
            "description": "이번 계산의 숨결 방식(NONE·MAX·OPTIMAL)",
            "example": "OPTIMAL"
          },
          "pricesObservedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "OPTIMAL 계산에 쓴 재료 시세 관측 시각. 다른 방식이면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedCostGold": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int64",
                "description": "OPTIMAL: 계획 전체 기대 비용(골드) = 단계 기대 비용을 올리기 전 값으로 더한 뒤 한 번 올림(스펙업 여러 단계 재련 비용과 같은 방식). 화면 합계는 이 값을 쓰고 단계 expectedCostGold를 더하지 않는다(단계마다 올리면 단계 수 − 1골드까지 커진다). 다른 방식이면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "failedAttemptsFrom": {
            "anyOf": [
              {
                "type": "string",
                "description": "첫 단계 실패 횟수를 정한 방법. REQUEST: 요청 currentFailedAttempts(없으면 0), SUCCESS_RATE: 요청 currentSuccessRate에서 정함. 모르는 값은 REQUEST처럼 다룬다",
                "example": "SUCCESS_RATE"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "assumptions",
          "breath",
          "equipmentType",
          "expResearch",
          "expectedCostGold",
          "expectedGold",
          "expectedMaterials",
          "fromStage",
          "grade",
          "growthCost",
          "growthSource",
          "growthSupport",
          "nonGold",
          "pricesObservedAt",
          "ruleVersion",
          "source",
          "stages",
          "toStage",
          "useBook",
          "useBreath",
          "worstCaseGold",
          "worstCaseMaterials"
        ]
      },
      "SourceResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "단계별 수치 출처"
          },
          "commit": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "crossCheckedWith": {
            "type": "string",
            "description": "교차 검증한 다른 출처"
          },
          "verifiedOn": {
            "type": "string"
          }
        },
        "required": [
          "commit",
          "crossCheckedWith",
          "license",
          "name",
          "verifiedOn"
        ]
      },
      "GrowthSourceResponse": {
        "type": "object",
        "properties": {
          "ruleVersion": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "성장 비용 출처"
          },
          "crossCheckedWith": {
            "type": "string",
            "description": "교차 확인"
          },
          "verifiedOn": {
            "type": "string"
          },
          "researchText": {
            "type": "string",
            "description": "영지 연구 공식 문구(재련 가이드)"
          }
        },
        "required": [
          "crossCheckedWith",
          "name",
          "researchText",
          "ruleVersion",
          "verifiedOn"
        ]
      },
      "StageResponse": {
        "type": "object",
        "properties": {
          "targetStage": {
            "type": "integer",
            "format": "int32",
            "description": "이 단계 재련 후 단계"
          },
          "firstAttemptSuccessRateBp": {
            "type": "integer",
            "format": "int32",
            "description": "첫 시도 성공률(만분율, 1 = 0.01%). 숨결·책 포함"
          },
          "expectedAttempts": {
            "type": "number",
            "description": "기대 시도 수"
          },
          "medianAttempts": {
            "type": "integer",
            "format": "int32",
            "description": "50% 확률로 이 시도 안에 성공"
          },
          "p90Attempts": {
            "type": "integer",
            "format": "int32",
            "description": "90% 확률로 이 시도 안에 성공"
          },
          "maxAttempts": {
            "type": "integer",
            "format": "int32",
            "description": "장인의 기운으로 확정되는 최대 시도 수"
          },
          "expectedMaterials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuantityResponse"
            }
          },
          "worstCaseMaterials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuantityResponse"
            }
          },
          "expectedGold": {
            "type": "number"
          },
          "worstCaseGold": {
            "type": "integer",
            "format": "int64"
          },
          "growth": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GrowthResponse",
                "description": "이 단계 성장(경험치) 비용. growthCost=false면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "breathPath": {
            "anyOf": [
              {
                "type": "array",
                "description": "OPTIMAL: 실패가 이어질 때 회차별 선택(같은 선택이 이어지는 회차 묶음, 회차는 1부터 양끝 포함, breaths 0 = 숨결 없음). 장인의 기운으로 확정되는 마지막 회차는 넣지 않는다. 다른 방식이면 null",
                "items": {
                  "$ref": "#/components/schemas/BreathRunResponse"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedBreaths": {
            "anyOf": [
              {
                "type": "number",
                "description": "OPTIMAL: 기대 숨결 개수. 다른 방식이면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedBooks": {
            "anyOf": [
              {
                "type": "number",
                "description": "OPTIMAL: 기대 책 권수. 다른 방식이면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedCostGold": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int64",
                "description": "OPTIMAL: 그 방법의 기대 비용(골드, 올림) = 재련 골드(업화 18단계까지 성장 지원 20% 적용) + 재료·파편 × 1개 즉시 구매 최저가 + 숨결·책 × 1개 값. 운명의 파편 1개 값은 거래소 파편 주머니(소 1000·중 2000·대 3000개) 가운데 1개당 가장 싼 값. 장비 성장(경험치) 비용·실링은 넣지 않는다. 다른 방식이면 null"
              },
              {
                "type": "null"
              }
            ]
          },
          "startFailedAttempts": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int32",
