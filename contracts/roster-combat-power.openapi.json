{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken roster-combat-power",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/roster-combat-power": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "원정대 캐릭터별 전투력",
        "description": "같은 서버 원정대 캐릭터마다 LOAKraken에 기록된 전투력과 그 값을 확인한 시각을 줍니다. 원정대 목록은 원정대 조회와 같은 캐시를 쓰고(없으면 공식 1회), 전투력은 기록만 읽습니다. 기록이 없으면 combatPower가 null이고, 불러오기(POST …/refresh)로 채울 수 있습니다. 정렬·식스맨·총합은 화면이 계산합니다.",
        "operationId": "view",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "원정대를 조회할 캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "원정대를 조회할 캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          }
        ],
        "responses": {
          "200": {
            "description": "CHARACTER_ROSTER_COMBAT_POWER_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseRosterCombatPowerResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_STORAGE_UNAVAILABLE 또는 LOST_ARK_NOT_CONFIGURED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/characters/roster-combat-power/refresh": {
      "post": {
        "tags": [
          "캐릭터"
        ],
        "summary": "원정대 전투력 불러오기",
        "description": "전투력 기록이 없거나 24시간 넘은 원정대 캐릭터를 아이템 레벨 높은 순으로 최대 12명 공식 프로필에서 불러와 기록합니다. 같은 원정대는 10분에 한 번이고(429 ROSTER_REFRESH_COOLDOWN, Retry-After), 같은 원정대 동시 요청은 한 번으로 묶습니다. 공식 호출 여유가 모자라면 받은 만큼만 기록하고 200에 remaining을 줍니다. 클라이언트당 분당 2회입니다.",
        "operationId": "refresh",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "원정대를 조회할 캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "원정대를 조회할 캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          }
        ],
        "responses": {
          "200": {
            "description": "CHARACTER_ROSTER_COMBAT_POWER_REFRESH_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseRosterCombatPowerRefreshResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "ROSTER_REFRESH_COOLDOWN(Retry-After 헤더) 또는 클라이언트 요청이 너무 많음 / CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_STORAGE_UNAVAILABLE, CHARACTER_CACHE_UNAVAILABLE 또는 LOST_ARK_NOT_CONFIGURED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseRosterCombatPowerResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/RosterCombatPowerResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "RosterCombatPowerResponse": {
        "type": "object",
        "description": "원정대 캐릭터별 전투력",
        "properties": {
          "items": {
            "type": "array",
            "description": "같은 서버 원정대 캐릭터(공식 원정대 순서)",
            "items": {
              "$ref": "#/components/schemas/RosterCombatPowerItemResponse"
            }
          },
          "missingCount": {
            "type": "integer",
            "format": "int32",
            "description": "전투력 기록이 없는 캐릭터 수"
          },
          "refreshAvailableAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "다시 불러올 수 있는 시각. 쿨다운 중이 아니면 null"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "missingCount",
          "refreshAvailableAt"
        ]
      },
      "RosterCombatPowerItemResponse": {
        "type": "object",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "serverName": {
            "type": "string"
          },
          "className": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "공식 원정대 목록의 직업"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "itemLevel": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number",
                    "description": "공식 원정대 목록의 아이템 레벨"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "combatPower": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number",
                    "description": "LOAKraken에 기록된 전투력. 기록이 없으면 null"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "combatPowerObservedAt": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "description": "그 전투력을 확인한 시각. 기록이 없으면 null"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "characterName",
          "className",
          "combatPower",
          "combatPowerObservedAt",
          "itemLevel",
          "serverName"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "ApiResponseRosterCombatPowerRefreshResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/RosterCombatPowerRefreshResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "RosterCombatPowerRefreshResponse": {
        "type": "object",
        "description": "원정대 전투력 불러오기 결과",
        "properties": {
          "items": {
            "type": "array",
            "description": "불러온 뒤의 원정대 캐릭터별 전투력",
            "items": {
              "$ref": "#/components/schemas/RosterCombatPowerItemResponse"
            }
          },
          "fetched": {
            "type": "integer",
            "format": "int32",
            "description": "이번에 공식 프로필을 부른 캐릭터 수"
          },
          "remaining": {
            "type": "integer",
            "format": "int32",
            "description": "아직 부르지 않은 대상 수(12명 상한·공식 호출 여유 부족). 0보다 크면 다시 불러오기"
          },
          "refreshAvailableAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "다시 불러올 수 있는 시각. 한 명도 못 불렀으면 null(바로 다시 가능)"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "fetched",
          "items",
          "refreshAvailableAt",
          "remaining"
        ]
      }
    }
  }
}
