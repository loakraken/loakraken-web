          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/RosterRankingResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "RosterRankingResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/StatsMetaResponse"
          },
          "basis": {
            "type": "string",
            "description": "ITEM_LEVEL·COMBAT_POWER·ROSTER_LEVEL(문자열, 값이 늘 수 있음)",
            "example": "ITEM_LEVEL"
          },
          "aggregate": {
            "type": "string",
            "description": "TOP6_AVG·TOP6_SUM·ALL_AVG(문자열, 값이 늘 수 있음). basis=ROSTER_LEVEL이면 쓰지 않음",
            "example": "TOP6_AVG"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "excludedRosters": {
            "type": "integer",
            "format": "int64",
            "description": "COMBAT_POWER에서 전투력 관측 누락으로 뺀 원정대 수(다른 기준은 0)"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RosterRankingRowResponse"
            }
          }
        }
      },
      "StatsMetaResponse": {
        "type": "object",
        "description": "공통 메타. 모집단은 LOAKraken이 관측한 캐릭터 중 최근 activeDays일 안에 프로필(전투력)을 확인한 캐릭터이며 게임 전체 인구가 아닙니다.",
        "properties": {
