{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken roster-ranking",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/rankings/rosters": {
      "get": {
        "tags": [
          "통계·랭킹"
        ],
        "summary": "원정대 랭킹",
        "description": "같은 서버 원정대(공식 원정대 캐릭터 목록)를 묶어 기준·합산 값 순으로 매긴 순위입니다. activeDays 안에 관측한 공개 캐릭터만 넣고, 대표는 아이템 레벨이 가장 높은 공개 캐릭터입니다. basis: ITEM_LEVEL(아이템 레벨), COMBAT_POWER(전투력, activeDays 안에 관측한 값만), ROSTER_LEVEL(원정대 레벨, aggregate는 쓰지 않음). aggregate: TOP6_AVG(상위 6명 평균), TOP6_SUM(상위 6명 합), ALL_AVG(전체 평균). 원정대 인원이 6명보다 적으면 있는 인원으로 계산하고 usedCharacters로 알립니다. COMBAT_POWER에서는 아이템 레벨 1640 이상인데 activeDays 안에 전투력을 관측하지 못한 캐릭터가 있는 원정대를 빼고 excludedRosters에 수를 줍니다. 값이 같으면(소수 둘째 자리) 같은 순위입니다. 모집단이 30 미만이면 sampleStatus=COLLECTING이지만 값·순위는 그대로 줍니다(참고값). 400 INVALID_REQUEST·STATS_INVALID_RANGE, 503 STATS_UNAVAILABLE",
        "operationId": "rosters",
        "parameters": [
          {
            "name": "server",
            "in": "query",
            "description": "서버 이름. 없으면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "activeDays",
            "in": "query",
            "description": "최근 며칠 안에 관측한 캐릭터(7·30·90, 기본 30)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "basis",
            "in": "query",
            "description": "ITEM_LEVEL(기본), COMBAT_POWER, ROSTER_LEVEL",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "ITEM_LEVEL|COMBAT_POWER|ROSTER_LEVEL"
            }
          },
          {
            "name": "aggregate",
            "in": "query",
            "description": "TOP6_AVG(기본), TOP6_SUM, ALL_AVG",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "TOP6_AVG|TOP6_SUM|ALL_AVG"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "1부터",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 201,
              "minimum": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "페이지 크기(기본 50, 최대 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseRosterRankingResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, STATS_INVALID_RANGE 또는 STATS_TOO_MANY_BINS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STATS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
