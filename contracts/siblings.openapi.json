{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken siblings",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/siblings": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "원정대 캐릭터 조회",
        "description": "공식 원정대 목록만 조회합니다. 캐릭터 검색과 별도로 캐시(기본 5분)하며 같은 이름의 동시 요청을 합칩니다. 공식 API가 빈 목록을 반환하면 존재하지 않는 캐릭터로 처리합니다.",
        "operationId": "siblings",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "원정대를 조회할 캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "원정대를 조회할 캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          }
        ],
        "responses": {
          "200": {
            "description": "원정대 조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCharacterSiblingsResponse"
                }
              }
            }
          },
          "400": {
            "description": "캐릭터명 누락 또는 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_FOUND: 공식 API 404 또는 빈 원정대 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "406": {
            "description": "NOT_ACCEPTABLE: JSON 이외의 응답 형식 요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "LOST_ARK_RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_SERVER_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "LOST_ARK_API_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "LOST_ARK_NOT_CONFIGURED 또는 CHARACTER_CACHE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "LOST_ARK_API_TIMEOUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseCharacterSiblingsResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CharacterSiblingsResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CharacterSiblingsResponse": {
        "type": "object",
        "description": "원정대 캐릭터 조회 결과. 조회한 캐릭터 자신을 포함합니다.",
        "properties": {
          "characterName": {
            "type": "string",
            "description": "요청한 캐릭터명(앞뒤 공백 제거·NFC 정규화)"
          },
          "siblings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SiblingResponse"
            }
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "description": "외부 API에서 원정대를 실제 수집한 UTC 시각. 캐시 조회에서도 유지됩니다."
          },
          "refreshAvailableAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "캐시 만료 예정 UTC 시각. 이 시각 이전 요청은 캐시를 반환해 fetchedAt이 바뀌지 않습니다. 캐시 적중에서도 유지되며 실제 만료는 1초 미만 늦을 수 있습니다. 알 수 없으면 null입니다."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "characterName",
          "fetchedAt",
          "refreshAvailableAt",
          "siblings"
        ]
      },
      "SiblingResponse": {
        "type": "object",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "serverName": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "characterLevel": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "integer",
                    "format": "int32"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "itemLevel": {
            "type": "number"
          }
        },
        "required": [
          "characterLevel",
          "characterName",
          "className",
          "itemLevel",
          "serverName"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
