{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken spec-up",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/spec-up": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "스펙업 가이드(공식 호출 없음)",
        "description": "캐릭터 캐시의 현재 세팅에서 후보 업그레이드마다 전투력 시뮬레이터를 변화 하나로 돌린 Δ전투력, 시세 캐시로 구한 비용, 1만 골드당 전투력을 줍니다. 후보끼리 Δ를 더하지 않습니다. 계산식이 확정되지 않은 후보도 status=UNSUPPORTED와 reasonCode·reason(같은 코드는 같은 문장)으로 남깁니다. limit은 OK 후보에만 적용하고(total = 자르기 전 OK 후보 수), UNSUPPORTED는 모두 뒤에 붙습니다. cost.status: OK(금액 있음)·PENDING(시세 칸을 아직 받지 못함)·UNKNOWN(비용 근거 없음). 보석 비용은 목표 레벨 즉시 구매 최저가 − 지금 보석 판매 기대가(거래소 수수료 5% 올림, 귀속이면 빼지 않음)입니다. kind·status·cost.status·reasonCode는 문자열이며 값이 늘 수 있습니다.",
        "operationId": "guide",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 1,
              "pattern": "\\s*[\\p{L}\\p{N}]+\\s*"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "EFFICIENCY(기본, 1만 골드당 전투력) 또는 DELTA(Δ전투력)",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "EFFICIENCY|DELTA"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "OK 후보 최대 개수(기본 20, 최대 50)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SPEC_UP_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSpecUpResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: 캐릭터명·sort·limit 형식",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "SPEC_UP_DISABLED: 기능이 꺼져 있음(메뉴 숨김) · CHARACTER_NOT_CACHED: 캐릭터를 먼저 검색해야 함(처리정지 목록 포함)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_STORAGE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/characters/spec-up/goal": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "스펙업 목표 경로(공식 호출 없음)",
        "description": "목표 전투력에 닿을 때까지 지금 상태에서 항목마다 다음 한 단계를 만들고, 효율 순(1만 골드당 전투력, 비용을 모르는 단계는 그 뒤에 Δ전투력 순)으로 가장 앞의 단계를 적용하기를 되풀이한 경로를 줍니다. 같은 항목을 여러 단계 올릴 수 있습니다. 모든 전투력은 전투력 시뮬레이터 결과입니다(steps[].change를 차례로 시뮬레이터에 넣은 값과 같음). 금액(cost.amount·cumulativeCost·totalCost)은 모두 골드입니다. 시세가 없는 단계가 있으면 그 단계부터 cumulativeCost와 totalCost는 null입니다(0으로 더하지 않음). 같은 보석 칸을 이어서 올리면 둘째 단계부터 비용은 이번 레벨 매입가 − 직전 레벨 매입가(GEM_STEP)라 단계 비용의 합은 마지막 레벨 매입가 − 처음 보석 판매 기대가입니다. 딜러가 아니거나 공식 전투력이 없으면 200, 빈 steps, stopReasonCode에 스펙업 가이드와 같은 이유 코드를 줍니다. 최대 30단계, 계산 시간 상한이 있습니다. 같은 캐릭터 수집 시각·시세 시각·목표는 10분 동안 캐시합니다(시간 상한으로 멈춘 결과는 캐시하지 않음). 요청이 많으면 429 CLIENT_RATE_LIMITED와 Retry-After(초)를 줍니다. 503은 저장소 장애이고 Retry-After가 없으니 잠시 뒤 다시 요청합니다. stopReasonCode·kind·cost.code는 문자열이며 값이 늘 수 있습니다.",
        "operationId": "goal",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 1,
              "pattern": "\\s*[\\p{L}\\p{N}]+\\s*"
            }
          },
          {
            "name": "targetCombatPower",
            "in": "query",
            "description": "목표 전투력(0 초과, 소수 둘째 자리까지, 지금 전투력의 2배 이하)",
            "required": true,
            "schema": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SPEC_UP_GOAL_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSpecUpGoalResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST: 캐릭터명·목표 형식(0 초과, 소수 둘째 자리까지) · SPEC_UP_GOAL_OUT_OF_RANGE: 목표가 지금 전투력의 2배 초과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "SPEC_UP_DISABLED: 기능이 꺼져 있음 · CHARACTER_NOT_CACHED: 캐릭터를 먼저 검색해야 함",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_STORAGE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
