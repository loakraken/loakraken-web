{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken stats-population",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/stats/population": {
      "get": {
        "tags": [
          "통계·랭킹"
        ],
        "summary": "전체 인구",
        "description": "LOAKraken이 확인한 모든 캐릭터(아이템 레벨이 있는 캐릭터, 처리정지 제외, 다른 필터 없음)의 주간 집계입니다. snapshotDate는 집계 기준일(KST 날짜)이고 첫 집계 전에는 null입니다. servers는 언제나 서버 전체 목록, classes와 levels(아이템 레벨 10 단위)는 server로 고른 범위입니다. total은 levels 합입니다. 1640 미만 캐릭터는 원정대 목록으로 저장돼 전투력·역할이 없습니다. 400 INVALID_REQUEST, 503 STATS_UNAVAILABLE",
        "operationId": "population",
        "parameters": [
          {
            "name": "server",
            "in": "query",
            "description": "서버명. 생략하면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "description": "서버명. 생략하면 전체",
              "maxLength": 32,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseStatsPopulationResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST 또는 STATS_INVALID_RANGE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STATS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseStatsPopulationResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "STATS_POPULATION_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/StatsPopulationResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "StatsPopulationResponse": {
        "type": "object",
        "properties": {
          "snapshotDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "집계 기준일(KST). 첫 집계 전에는 null"
          },
          "server": {
            "type": [
              "string",
              "null"
            ],
            "description": "고른 서버. 전체면 null"
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "고른 범위의 캐릭터 수(levels 합)"
          },
          "servers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatsPopulationCountResponse"
            }
          },
          "classes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatsPopulationCountResponse"
            }
          },
          "levels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatsPopulationLevelResponse"
            }
          }
        },
        "required": [
          "snapshotDate",
          "server",
          "total",
          "servers",
          "classes",
          "levels"
        ]
      },
      "StatsPopulationCountResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "서버명 또는 직업명"
          },
          "count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "캐릭터 수"
          }
        },
        "required": [
          "name",
          "count"
        ]
      },
      "StatsPopulationLevelResponse": {
        "type": "object",
        "properties": {
          "from": {
            "type": "number",
            "format": "double",
            "description": "아이템 레벨 구간 시작(포함)"
          },
          "to": {
            "type": "number",
            "format": "double",
            "description": "아이템 레벨 구간 끝(제외)"
          },
          "count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "캐릭터 수"
          }
        },
        "required": [
          "from",
          "to",
          "count"
        ]
      },
      "StatsMetaResponse": {
        "type": "object",
        "description": "공통 메타. 모집단은 LOAKraken이 관측한 캐릭터 중 최근 activeDays일 안에 프로필(전투력)을 확인한 캐릭터이며 게임 전체 인구가 아닙니다.",
        "properties": {
          "population": {
            "type": "integer",
            "format": "int64",
            "description": "조건에 맞는 캐릭터 수"
          },
          "conditions": {
            "$ref": "#/components/schemas/StatsConditionsResponse"
          },
          "aggregatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "snapshot": {
            "type": "string",
            "description": "현재는 latest만 제공합니다",
            "example": "latest"
          },
          "ruleVersion": {
            "type": "string",
            "example": "stats-v1"
          },
          "minSample": {
            "type": "integer",
            "format": "int32",
            "example": 30
          },
          "sampleStatus": {
            "type": "string",
            "description": "COLLECTING(표본 30명 미만) 또는 READY",
            "enum": [
              "COLLECTING",
              "READY"
            ]
          },
          "coverage": {
            "$ref": "#/components/schemas/StatsCoverageResponse"
          },
          "populationUnit": {
            "type": "string",
            "description": "population을 세는 단위: CHARACTER(캐릭터), ROSTER(원정대), GUILD(길드). 문자열이며 값이 늘 수 있음",
            "example": "CHARACTER"
          }
        },
        "required": [
          "aggregatedAt",
          "conditions",
          "coverage",
          "minSample",
          "population",
          "populationUnit",
          "ruleVersion",
          "sampleStatus",
          "snapshot"
        ]
      },
      "StatsConditionsResponse": {
        "type": "object",
        "description": "정규화한 조건(기본값 포함)",
        "properties": {
          "server": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "DEALER",
                  "SUPPORT"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "className": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "activeDays": {
            "type": "integer",
            "format": "int32",
            "description": "최근 확인 기간(일): 7, 30, 90"
          },
          "itemLevelMin": {
            "type": "number"
          },
          "itemLevelMax": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "combatPowerMin": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "combatPowerMax": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "representativeOnly": {
            "type": "boolean",
            "description": "원정대(같은 서버) 대표 캐릭터(아이템 레벨 최고)만"
          }
        },
        "required": [
          "activeDays",
          "className",
          "combatPowerMax",
          "combatPowerMin",
          "itemLevelMax",
          "itemLevelMin",
          "representativeOnly",
          "role",
          "server"
        ]
      },
      "StatsCoverageResponse": {
        "type": "object",
        "description": "수집 범위. 표본이 어디까지 모였는지 보여 줍니다.",
        "properties": {
          "observedCharacters": {
            "type": "integer",
            "format": "int64",
            "description": "프로필(전투력)을 확인한 캐릭터 수"
          },
          "knownCharacters": {
            "type": "integer",
            "format": "int64",
            "description": "원정대로 발견한 캐릭터 포함 전체"
          },
          "discoveredAccounts": {
            "type": "integer",
            "format": "int64",
            "description": "원정대를 훑은 계정 수"
          }
        },
        "required": [
          "discoveredAccounts",
          "knownCharacters",
          "observedCharacters"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
