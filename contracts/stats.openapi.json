  "components": {
    "schemas": {
      "ApiResponseStatsSummaryResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/StatsSummaryResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "StatsSummaryResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/StatsMetaResponse"
          },
          "itemLevelMean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "itemLevelMedian": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "combatPowerMedian": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "combatPowerP90": {
            "anyOf": [
              {
                "type": "number",
                "description": "전투력 상위 10% 기준선(90번째 백분위수)"
              },
              {
                "type": "null"
              }
            ]
          },
          "dealers": {
            "type": "integer",
            "format": "int64"
          },
          "supports": {
            "type": "integer",
            "format": "int64"
          },
          "unknownRole": {
            "type": "integer",
            "format": "int64",
