{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken suggest",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/suggest": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "캐릭터 이름 자동완성(공식 호출 없음)",
        "description": "LOAKraken에 기록된 캐릭터 중 이름이 q로 시작하는 캐릭터를 아이템 레벨 높은 순으로 최대 8개 줍니다. 공식 API를 부르지 않고, 검색한 사람과 입력은 기록하지 않습니다. q는 앞뒤 공백을 지우고 NFC로 맞춥니다. 한글 완성형 글자만이면 1자부터, 그 밖에는 2자부터 찾고, 짧거나 12자를 넘으면 빈 목록입니다. 대소문자를 구분합니다. 응답은 60초 동안 브라우저 캐시할 수 있습니다.",
        "operationId": "suggest",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "이름 앞부분",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "언새"
          }
        ],
        "responses": {
          "200": {
            "description": "CHARACTER_SUGGEST_SUCCESS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCharacterSuggestResponse"
                }
              }
            }
          },
          "429": {
            "description": "요청이 너무 많음(클라이언트별 횟수 제한) / CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_STORAGE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseCharacterSuggestResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CharacterSuggestResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CharacterSuggestResponse": {
        "type": "object",
        "description": "캐릭터 이름 자동완성(#369)",
        "properties": {
          "items": {
            "type": "array",
            "description": "아이템 레벨 높은 순, 최대 8개. 없으면 빈 배열",
            "items": {
              "$ref": "#/components/schemas/CharacterSuggestItemResponse"
            }
          }
        }
      },
      "CharacterSuggestItemResponse": {
        "type": "object",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "serverName": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "itemLevel": {
            "type": "number",
            "description": "마지막으로 기록한 아이템 레벨"
          },
          "characterImage": {
            "type": "string",
            "description": "공식 프로필 초상 이미지 주소. 프로필을 아직 기록하지 않았으면 null"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
