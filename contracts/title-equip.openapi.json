{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken title-equip",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/titles/equipped": {
      "get": {
        "tags": [
          "통계·랭킹"
        ],
        "summary": "칭호 장착 확인 비율",
        "description": "activeDays 안에 프로필을 관측한 원정대(공개 캐릭터가 있는 원정대) N개(meta.population) 가운데, 그 칭호를 장착한 공개 캐릭터가 같은 기간에 확인된 원정대 수(equippedRosters)와 비율입니다. 공식 프로필에는 장착 중인 칭호만 있어 가진 칭호 전체는 알 수 없습니다(장착하지 않은 칭호는 세지 않음). title을 주면 그 칭호만, 없으면 확인된 칭호 전체(원정대 수 내림차순)입니다. 모집단이 30 미만이면 sampleStatus=COLLECTING이지만 비율은 그대로 줍니다(참고값). 400 INVALID_REQUEST·STATS_INVALID_RANGE, 503 STATS_UNAVAILABLE",
        "operationId": "equipped",
        "parameters": [
          {
            "name": "server",
            "in": "query",
            "description": "서버 이름. 없으면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            }
          },
          {
            "name": "activeDays",
            "in": "query",
            "description": "최근 며칠 안에 관측한 원정대(7·30·90, 기본 30)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "title",
            "in": "query",
            "description": "공식 칭호 문자열. 없으면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128,
              "minLength": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTitleEquipResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, STATS_INVALID_RANGE 또는 STATS_TOO_MANY_BINS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "CLIENT_RATE_LIMITED: 이 클라이언트의 분당 요청·공식 호출 한도 초과. Retry-After(초) 뒤 다시 시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "STATS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseTitleEquipResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/TitleEquipResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "TitleEquipResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/StatsMetaResponse"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "description": "요청한 칭호(없으면 null = 전체)"
              },
              {
                "type": "null"
              }
            ]
          },
          "titles": {
            "type": "array",
            "description": "장착이 확인된 칭호(원정대 수 내림차순, 같으면 칭호 문자열의 코드 포인트 순)",
            "items": {
              "$ref": "#/components/schemas/EquippedTitleResponse"
            }
          }
        },
        "required": [
          "meta",
          "title",
          "titles"
        ]
      },
      "StatsMetaResponse": {
        "type": "object",
        "description": "공통 메타. 모집단은 LOAKraken이 관측한 캐릭터 중 최근 activeDays일 안에 프로필(전투력)을 확인한 캐릭터이며 게임 전체 인구가 아닙니다.",
        "properties": {
          "population": {
            "type": "integer",
            "format": "int64",
            "description": "조건에 맞는 캐릭터 수"
          },
          "conditions": {
            "$ref": "#/components/schemas/StatsConditionsResponse"
          },
          "aggregatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "snapshot": {
            "type": "string",
            "description": "현재는 latest만 제공합니다",
            "example": "latest"
          },
          "ruleVersion": {
            "type": "string",
            "example": "stats-v1"
          },
          "minSample": {
            "type": "integer",
            "format": "int32",
            "example": 30
          },
          "sampleStatus": {
            "type": "string",
            "description": "COLLECTING(표본 30명 미만) 또는 READY",
            "enum": [
              "COLLECTING",
              "READY"
            ]
          },
          "coverage": {
            "$ref": "#/components/schemas/StatsCoverageResponse"
          },
          "populationUnit": {
            "type": "string",
            "description": "population을 세는 단위: CHARACTER(캐릭터), ROSTER(원정대), GUILD(길드). 문자열이며 값이 늘 수 있음",
            "example": "CHARACTER"
          }
        },
        "required": [
          "aggregatedAt",
          "conditions",
          "coverage",
          "minSample",
          "population",
          "populationUnit",
          "ruleVersion",
          "sampleStatus",
          "snapshot"
        ]
