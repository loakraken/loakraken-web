{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken titles",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/titles": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "원정대 보유 칭호(관측 기준)",
        "description": "같은 서버 원정대 캐릭터가 LOAKraken에서 검색·수집될 때 장착한 칭호를 처음 확인한 순서로 줍니다. 장착한 칭호만 기록되며 실제 획득일·획득 순서와 다를 수 있습니다. 공식 API는 현재 장착 칭호 하나만 제공합니다. 원정대 목록은 /siblings 캐시를 공유합니다(공식 호출 최대 1회).",
        "operationId": "titles",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "원정대를 조회할 캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "원정대를 조회할 캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공(기록 없음 포함)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseRosterTitlesResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "CHARACTER_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "LOST_ARK_RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "LOST_ARK_API_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_HISTORY_DISABLED, CHARACTER_HISTORY_UNAVAILABLE, LOST_ARK_NOT_CONFIGURED 또는 CHARACTER_CACHE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "LOST_ARK_API_TIMEOUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseRosterTitlesResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/RosterTitlesResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "RosterTitlesResponse": {
        "type": "object",
        "description": "원정대 보유 칭호(title-record-v1). LOAKraken에서 처음 확인한 순서입니다. 장착한 칭호만 기록되며 실제 획득일·획득 순서와 다를 수 있습니다. 기록이 없어도 200입니다.",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "serverName": {
            "type": "string"
          },
          "rosterCharacters": {
            "type": "integer",
            "format": "int32",
            "description": "같은 서버 원정대 캐릭터 수"
          },
          "observedCharacters": {
            "type": "integer",
            "format": "int32",
            "description": "그중 칭호 기록이 있는 캐릭터 수"
          },
          "ruleVersion": {
            "type": "string",
            "example": "title-record-v1"
          },
          "titles": {
            "type": "array",
            "description": "처음 확인한 순서(observedOrder 오름차순)",
            "items": {
              "$ref": "#/components/schemas/RosterTitleResponse"
            }
          }
        },
        "required": [
          "characterName",
          "observedCharacters",
          "rosterCharacters",
          "ruleVersion",
          "serverName",
          "titles"
        ]
      },
      "RosterTitleResponse": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "firstObservedAt": {
            "type": "string",
            "format": "date-time",
            "description": "LOAKraken이 이 칭호를 장착 상태로 처음 확인한 시각(획득일 아님)"
          },
          "lastObservedAt": {
            "type": "string",
            "format": "date-time",
            "description": "마지막으로 장착 상태를 확인한 시각"
          },
          "observedOrder": {
            "type": "integer",
            "format": "int32",
            "description": "처음 확인한 순서(1부터). 획득 순서가 아님"
          },
          "recordedBy": {
            "type": "string",
            "description": "처음 확인한 원정대 캐릭터"
          },
          "source": {
            "type": "string",
            "description": "OBSERVED: LOAKraken 관측. 공식 보유 목록이 생기면 OFFICIAL을 추가한다",
            "enum": [
              "OBSERVED",
              "OFFICIAL"
            ]
          }
        },
        "required": [
          "firstObservedAt",
          "lastObservedAt",
          "observedOrder",
          "recordedBy",
          "source",
          "title"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
