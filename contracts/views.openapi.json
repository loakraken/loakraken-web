{
  "openapi": "3.1.0",
  "info": {
    "title": "LOAKraken views",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/characters/views": {
      "get": {
        "tags": [
          "캐릭터"
        ],
        "summary": "캐릭터 조회수",
        "description": "LOAKraken 캐릭터 검색 성공 횟수를 KST 일별로 집계한 값입니다. 최근 days일(기본 112일=16주)을 0으로 채워 주고 기간·전체 합계를 함께 줍니다. 외부 호출이 없습니다. 조회한 사람을 식별하지 않으므로 반복 조회도 셉니다.",
        "operationId": "views",
        "parameters": [
          {
            "name": "characterName",
            "in": "query",
            "description": "캐릭터명",
            "required": true,
            "schema": {
              "type": "string",
              "description": "캐릭터명",
              "example": "모험가",
              "maxLength": 64,
              "minLength": 0,
              "pattern": "[\\p{L}\\p{N}]+"
            },
            "example": "모험가"
          },
          {
            "name": "days",
            "in": "query",
            "description": "오늘(KST)까지 일수. 기본 112(16주)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 112,
              "description": "오늘(KST)까지 일수. 기본 112(16주)",
              "maximum": 366,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCharacterViewsResponse"
                }
              }
            }
          },
          "400": {
            "description": "캐릭터명·일수 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "CHARACTER_VIEWS_DISABLED 또는 CHARACTER_VIEWS_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseCharacterViewsResponse": {
        "type": "object",
        "description": "공통 API 응답. 오류 응답의 data는 null입니다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "업무 결과 코드",
            "example": "CHARACTER_SEARCH_SUCCESS"
          },
          "message": {
            "type": "string",
            "description": "공개용 안내 메시지",
            "example": "캐릭터 조회에 성공했습니다."
          },
          "data": {
            "$ref": "#/components/schemas/CharacterViewsResponse",
            "description": "성공 응답 데이터. 오류일 때 null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      },
      "CharacterViewsResponse": {
        "type": "object",
        "description": "LOAKraken 캐릭터 검색 조회수(KST 일별). 조회한 사람을 식별하지 않아 같은 사람의 반복 조회도 셉니다. 개인정보는 저장하지 않습니다.",
        "properties": {
          "characterName": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "days": {
            "type": "array",
            "description": "from~to의 모든 날짜(오래된 날부터, 조회 없으면 0)",
            "items": {
              "$ref": "#/components/schemas/CharacterDailyViewsResponse"
            }
          },
          "rangeTotal": {
            "type": "integer",
            "format": "int64",
            "description": "기간 합계"
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "집계 시작 이후 전체 합계"
          }
        },
        "required": [
          "characterName",
          "days",
          "from",
          "rangeTotal",
          "timezone",
          "to",
          "total"
        ]
      },
      "CharacterDailyViewsResponse": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "count": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "count",
          "date"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "공통 오류 응답. HTTP 상태와 업무 코드를 함께 확인합니다.",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "data",
          "message"
        ]
      }
    }
  }
}
