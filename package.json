{
  "name": "loakraken-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:regressions": "node scripts/check-regressions.mjs",
    "api:generate": "openapi-typescript contracts/character.openapi.json -o lib/api/schema.d.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:mock": "node tests/mock-backend.mjs",
    "api:generate:market": "openapi-typescript contracts/market.openapi.json -o lib/api/market-schema.d.ts",
    "api:generate:siblings": "openapi-typescript contracts/siblings.openapi.json -o lib/api/siblings-schema.d.ts",
    "api:generate:history": "openapi-typescript contracts/history.openapi.json -o lib/api/history-schema.d.ts",
    "api:generate:refining": "openapi-typescript contracts/refining.openapi.json -o lib/api/refining-schema.d.ts",
    "api:generate:crit-speed": "openapi-typescript contracts/crit-speed.openapi.json -o lib/api/crit-speed-schema.d.ts",
    "api:generate:views": "openapi-typescript contracts/views.openapi.json -o lib/api/views-schema.d.ts",
    "api:generate:home": "openapi-typescript contracts/home.openapi.json -o lib/api/home-schema.d.ts",
    "start:standalone": "node -e \"const fs=require('fs');fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});if(fs.existsSync('public'))fs.cpSync('public','.next/standalone/public',{recursive:true});\" && node .next/standalone/server.js",
    "api:generate:card-collection": "openapi-typescript contracts/card-collection.openapi.json -o lib/api/card-collection-schema.d.ts",
    "api:generate:popular": "openapi-typescript contracts/popular.openapi.json -o lib/api/popular-schema.d.ts",
    "api:generate:spec-up": "openapi-typescript contracts/spec-up.openapi.json -o lib/api/spec-up-schema.d.ts",
    "api:generate:rank": "openapi-typescript contracts/rank.openapi.json -o lib/api/rank-schema.d.ts",
    "api:generate:titles": "openapi-typescript contracts/titles.openapi.json -o lib/api/titles-schema.d.ts",
    "api:generate:receipt": "openapi-typescript contracts/receipt.openapi.json -o lib/api/receipt-schema.d.ts",
    "api:generate:stats": "openapi-typescript contracts/stats.openapi.json -o lib/api/stats-schema.d.ts",
    "api:generate:rankings": "openapi-typescript contracts/rankings.openapi.json -o lib/api/rankings-schema.d.ts",
    "api:generate:combat-power": "openapi-typescript contracts/combat-power.openapi.json -o lib/api/combat-power-schema.d.ts",
    "api:generate:accessory-search": "openapi-typescript contracts/accessory-search.openapi.json -o lib/api/accessory-search-schema.d.ts",
    "api:generate:item-tooltips": "openapi-typescript contracts/item-tooltips.openapi.json -o lib/api/item-tooltips-schema.d.ts",
    "api:generate:roster-combat-power": "openapi-typescript contracts/roster-combat-power.openapi.json -o lib/api/roster-combat-power-schema.d.ts",
    "api:generate:guild-ranking": "openapi-typescript contracts/guild-ranking.openapi.json -o lib/api/guild-ranking-schema.d.ts",
    "api:generate:title-equip": "openapi-typescript contracts/title-equip.openapi.json -o lib/api/title-equip-schema.d.ts",
    "api:generate:auction-gems": "openapi-typescript contracts/auction-gems.openapi.json -o lib/api/auction-gems-schema.d.ts",
    "api:generate:auction-accessories": "openapi-typescript contracts/auction-accessories.openapi.json -o lib/api/auction-accessories-schema.d.ts",
    "api:generate:public-summary": "openapi-typescript contracts/public-summary.openapi.json -o lib/api/public-summary-schema.d.ts",
    "api:generate:popular-guilds": "openapi-typescript contracts/popular-guilds.openapi.json -o lib/api/popular-guilds-schema.d.ts",
    "api:generate:class-builds": "openapi-typescript contracts/class-builds.openapi.json -o lib/api/class-builds-schema.d.ts",
    "api:generate:market-minutes": "openapi-typescript contracts/market-minutes.openapi.json -o lib/api/market-minutes-schema.d.ts",
    "api:generate:best-combat-power": "openapi-typescript contracts/best-combat-power.openapi.json -o lib/api/best-combat-power-schema.d.ts",
    "api:generate:guild-detail": "openapi-typescript contracts/guild-detail.openapi.json -o lib/api/guild-detail-schema.d.ts",
    "api:generate:alerts": "openapi-typescript contracts/alerts.openapi.json -o lib/api/alerts-schema.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
